[Unit]
Description=Shared Memory Framework — quiesced backup of Postgres + Neo4j
Documentation=https://github.com/KanenasInGreece/Shared_Memory

[Service]
Type=oneshot
# Set WorkingDirectory to your repo root; backup.sh resolves shared-memory/.env
# from there (creds + BACKUP_* knobs), falling back to a pre-0.6 repo-root .env.
# Override with --env <path> if your env lives elsewhere.
# The script self-locks (flock) against overlap.
WorkingDirectory=/path/to/your/shared-memory-GitHub
ExecStart=/usr/bin/env bash shared-memory/ops/backup.sh
# S-17 (Credential_Custody_Plan PR A4) — cheap, verified-compatible hardening,
# same reasoning as hive-mind-gateway.service: this script creates dump files
# (pgdump/cypher.gz — secrets-adjacent, not secrets themselves, but tightly
# scoped by default is still the right posture) and never needs elevated
# privileges. ProtectHome intentionally left out for the same reason as the
# gateway unit — BACKUP_DIR defaults to ~/.shared-memory/backups, under $HOME.
UMask=0077
NoNewPrivileges=yes

# S16 (HYG round) — LimitCORE=0: same reasoning as hive-mind-gateway.service,
# and more pointed here — backup.sh's init_secrets_dir() writes the curl auth
# bearer token and BOTH database passwords to plaintext files (mode 600) for
# the run's duration; a core dump of this process would capture them from its
# own environment/heap even faster than from a .env read. See
# ops/README.md's "Hardening" section for the temporary lift procedure.
LimitCORE=0

# ProtectSystem=full (HYG round) was evaluated and left OUT of THIS unit:
# backup.sh's init_secrets_dir() (ops/backup.sh) calls `mktemp -d` to hold the
# curl auth header and the Postgres/Neo4j --env-files for docker exec — that
# directory is under /tmp (or $TMPDIR) by default, not under %h. As with the
# gateway unit, ProtectSystem=full only makes /usr, /boot and /etc read-only
# and would not actually block this write, but the write-path-under-%h
# precondition this round required does not hold, so the directive is
# withheld and the finding is recorded. See S2_eps_HANDOFF.md §5.
