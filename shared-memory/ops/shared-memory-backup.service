[Unit]
Description=Shared Memory Framework — quiesced backup of Postgres + Neo4j
Documentation=https://github.com/KanenasInGreece/Shared_Memory

[Service]
Type=oneshot
# Repo root. backup.sh reads shared-memory/.env from here (pre-0.6 fallback: a repo-root .env) unless you pass --env. It flock's itself so two runs cannot overlap.
WorkingDirectory=/path/to/your/shared-memory-GitHub
ExecStart=/usr/bin/env bash shared-memory/ops/backup.sh
# Dumps are secrets-adjacent, so new files are 0600, and this script never needs extra privileges. ProtectHome stays off because BACKUP_DIR defaults to ~/.shared-memory/backups.
UMask=0077
NoNewPrivileges=yes

# init_secrets_dir() holds the bearer token and both database passwords in this process. A core dump would capture them.
LimitCORE=0

# `full` does not touch /tmp, where init_secrets_dir() puts the docker-exec env files. `strict` is forbidden because it makes the home directory read-only.
ProtectSystem=full
