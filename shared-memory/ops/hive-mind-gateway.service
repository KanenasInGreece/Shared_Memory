[Unit]
Description=Shared Memory Hive-Mind Gateway (coordinator + consolidation + REM daemons)
Documentation=https://github.com/KanenasInGreece/Shared_Memory
# Ordering only. The coordinator already waits PG_STARTUP_WAIT_S for Postgres; Restart= is the backstop after that window.
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
# Repo root. hive_mind_proxy.py loads the .env beside this checkout.
WorkingDirectory=/path/to/your/shared-memory-GitHub
# requirements-gateway.lock is the gateway's narrower pin, resolved from WorkingDirectory. The uv path is a placeholder: install_service.sh substitutes the host uv, because a unit PATH misses ~/.local/bin and the service crash-loops 203/EXEC.
ExecStart=/usr/bin/uv run --no-project --with-requirements requirements-gateway.lock python shared-memory/scripts/hive_mind_proxy.py 8888
# Daemons are spawned via `uv` on PATH. install_service.sh prepends that directory, or they stay stopped while the gateway looks healthy.
Environment=PATH=/usr/local/bin:/usr/bin:/bin
# The proxy drains daemons on SIGTERM; do not let systemd send SIGKILL first.
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=on-failure
RestartSec=5

# Files this process creates default to 0600/0700, including ones that never set their own mode.
UMask=0077
# Never needs setuid, setgid, or extra capabilities.
NoNewPrivileges=yes

# A core would hold every secret loaded from shared-memory/.env. A stop that hits Fedora's timeout-abort also dumps a core.
LimitCORE=0

# ProtectHome stays off: WorkingDirectory and the default logs are under $HOME, and this unit cannot name that deployer-chosen path as an exception.
# ProtectSystem=full leaves /tmp, /run, and $XDG_RUNTIME_DIR writable, which is where the socket lives. `strict` is forbidden because it makes the home directory read-only.
ProtectSystem=full

# Closed to the families this process actually opens. AF_NETLINK is required for getaddrinfo and for nvtop behind gpu_load.py; dropping it makes the GPU probe read unknown.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

# Uncomment to deliver a secret outside shared-memory/.env. Bare id only: an absolute path this --user unit cannot read is fatal at start, while a missing bare id is not.
# The user manager looks in ~/.config/credstore/. Write the file 600 from the first byte; create-then-chmod briefly exposes it at the default umask.
# This does not hide the credential from the account that runs the unit.
#   mkdir -p ~/.config/credstore && chmod 700 ~/.config/credstore
#   ( umask 077; printf '%s' 'your-postgres-password' > ~/.config/credstore/pg_password )
#LoadCredential=pg_password
#LoadCredential=neo4j_password

[Install]
WantedBy=default.target
