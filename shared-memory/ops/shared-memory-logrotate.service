[Unit]
Description=Shared Memory Framework — rotate gateway/REM audit logs
Documentation=https://github.com/KanenasInGreece/Shared_Memory

[Service]
Type=oneshot
# Per-user logrotate, no root. The config is generated from ops/shared-memory.logrotate into the home directory.
ExecStart=/usr/bin/logrotate --state %h/.shared-memory/logrotate.state %h/.config/shared-memory/logrotate.conf
# No unit UMask: rotated-file mode comes from the logrotate `create` stanza, and a second place to set it would drift. ProtectHome is incompatible because the job is writing under the home directory.
NoNewPrivileges=yes

# Same core ban as the other two units, even though logrotate loads no framework secret.
LimitCORE=0

# Every write this unit makes is under the home directory, so making /usr, /boot, and /etc read-only does not block rotation.
ProtectSystem=full
