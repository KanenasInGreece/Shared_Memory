# =============================================================
# Shared Memory Framework — FRAMEWORK Configuration
#
# Read by gateway/daemons and docker-compose (data paths + DB passwords below):
#     shared-memory/.env         ← live values (gitignored, NEVER commit)
#     shared-memory/.env.example ← sanitized template (committed)
# Client tokens live separately in skill .envs (AGENT_TOKEN);
# see shared-memory-skill/shared-memory/.env.example.
#
# Setup: run `bash shared-memory/scripts/install_framework.sh` or copy to
# shared-memory/.env and fill in values by hand.
# =============================================================
# Compose mounts data, logs, import, plugins under this dir. No trailing slash.
NEO4J_HOST_DIR=/your/data/path/neo4j
# Postgres data dir.
PG_DATA_DIR=/your/data/path/postgres
# GGUF dir for bundled embedder/reranker. Leave if another server serves them.
LLM_MODELS_DIR=/path/to/your/LLM_Models

# Set LLM_MODELS_DIR absolute: relative paths resolve against shared-memory/ops/,
# not cwd.

# EMBED_MODEL_SUBPATH=gpustack/bge-m3-GGUF/bge-m3-Q8_0.gguf
# RERANK_MODEL_SUBPATH=gpustack/bge-reranker-v2-m3-GGUF/bge-reranker-v2-m3-Q8_0.gguf
# -------------------------------------------------------------
# Neo4j REFUSES to boot when heap max + pagecache exceed physical RAM; hosts
# under ~8 GB lower these here, never in tracked yaml. Small-host preset:
# NEO4J_HEAP_INITIAL=256M
# NEO4J_HEAP_MAX=512M
# NEO4J_PAGECACHE=256M

# Mandatory secrets. Suffixes _PASSWORD/_TOKEN/_API_KEY/_SECRET/_KEY/_CREDENTIAL(S)
# can also come from $CREDENTIALS_DIRECTORY or a _FILE pointer; neither reaches a child
# env. An exported key wins and logs an advisory. Setting a _FILE pointer makes that key
# a candidate; non-secret-shaped names are ignored; non-absolute paths fail to resolve.
# PG_PASSWORD_FILE=/run/secrets/pg_password
# One balanced pair of surrounding quotes is stripped: a value you quoted expecting
# the quotes to be part of it is read without them.
NEO4J_PASSWORD=your-neo4j-password-here
PG_PASSWORD=your-postgres-password-here

# Optional for LM Studio web-search MCP (README §16). Consumed by mcp.json -> tavily-mcp;
# Python stack does not read it. Ships commented out to avoid live placeholder values.
# TAVILY_API_KEY=your-tavily-api-key-here
# -------------------------------------------------------------
# GATEWAY .env: Agent token registry (generate_tokens.py). Unset means auth off.
# Format is comma-separated name:sha256:<64 hex>; plaintext entries make gateway
# REFUSE TO START. Leave commented: bootstrap_tokens.sh provides the only live
# assignment. A second live line worked only because the parser takes the last one.
# AGENT_TOKENS=
# GATEWAY .env: S-05 (decision:1303): unset AGENT_TOKENS with a resolved backend
# token_env makes the gateway REFUSE TO START (auth-off disables in-flight caps and the
# audit path). Configure AGENT_TOKENS, or set this to accept deliberately. With auth
# off, only a spawned daemon reaches chat.
# With AGENT_TOKENS set, LLM_FRAMEWORK_AGENT_NAMES entries are admitted too.
# ALLOW_UNAUTHENTICATED_PROVIDER_KEYS=1
# GATEWAY .env: optional read-only roles for ops clients (e.g. shared-memory-monitor).
# A read token may reach GET /memory/telemetry, POST /memory/search and
# GET /memory/status/{pg_id}; POST /memory/graph is 403; GET /health is anonymous
# (not a read-role grant). Unset = full read/write for ordinary names, but `monitor`
# and SHARED_MEMORY_READ_ONLY_AGENTS are always read-only, and `maintenance-admin` is
# admin unless declared read. Format: comma-separated name:role ("read", "full",
# "admin" = /admin/* only).
# AGENT_ROLES=monitor:read
# GATEWAY .env: extra names confined to read-only routes. Adds to roster; never widens a
# read-only identity. Names with `:`, newlines, or carriage returns cause bulk mint to
# refuse.
# SHARED_MEMORY_READ_ONLY_AGENTS=

# Local agent skill .env locations for token minting (remote agents: use
# `generate_tokens.py --reveal`). Splits on first colon: name:path is kind skill
# forever; `name:kind:path` registers mcp. Leave commented: a live empty line is not the
# assignment bootstrap_tokens.sh should write.
#   AGENT_INSTALLS=claude:/home/you/.claude/skills/shared-memory/.env,opencode:mcp:/home/you/.config/opencode/shared-memory-mcp/.env
# AGENT_INSTALLS=

# AGENT skill .env (NOT gateway): distinct token per agent — never shared.
# LM Studio: set in mcp.json env block instead, then restart LM Studio.
# AGENT_TOKEN=tok_change_me_abc123
# -------------------------------------------------------------
MEMORY_LOG_LEVEL=0

# Per-tool log dir, merged daily by consolidation daemon.
MEMORY_LOG_PATH=~/.shared-memory/logs

# REM outbox audit log (JSONL, one entry per reviewed row). Empty = disabled (default).
# Never auto-rotated.
AUDIT_LOG_PATH=
# Gateway per-request audit log (JSONL). Empty disables it. Never auto-rotated.
# GATEWAY_AUDIT_LOG_PATH=~/.shared-memory/logs/gateway-audit.jsonl
# Credential-events log (JSONL; on by default; empty string disables). Logs key
# rejections, gateway faults, rate-limited token failures, daemon mints; never values.
# Rotation requires ops/shared-memory-logrotate.timer.
# CREDENTIAL_AUDIT_LOG_PATH=~/.shared-memory/logs/credential-audit.jsonl
# TOKEN_VERIFY_FAILED_LOG_RATE=60
# TOKEN_VERIFY_FAILED_LOG_WINDOW=60
# -------------------------------------------------------------

# Gateway stamps `principal` from kernel (SO_PEERCRED), never request, preventing
# forgery. Requires AF_UNIX listener; absent over TCP.
#
# Gateway Unix socket (default $XDG_RUNTIME_DIR/shared-memory-gw.sock; empty disables;
# multi-user setups set shared path and widen mode).
# GATEWAY_UDS_PATH=
# GATEWAY_UDS_MODE=0600
#
# Reject write routes lacking kernel-attested principal. Enable when all writers
# use socket.
# GATEWAY_REQUIRE_PRINCIPAL=0
#
# Client socket for memory_bridge (empty forces TCP; must match GATEWAY_UDS_PATH).
# COORDINATOR_UDS=

# Gateway bind interface (README §9 / SECURITY.md). Default 127.0.0.1 (localhost only).
# Set 0.0.0.0 ONLY behind an encrypted overlay (Tailscale / WireGuard / TLS) — bearer
# tokens are plaintext over HTTP.
# PROXY_BIND=127.0.0.1
# Every httpx client uses trust_env=False, so HTTP_PROXY, HTTPS_PROXY, ALL_PROXY,
# NO_PROXY, SSL_CERT_FILE and SSL_CERT_DIR are ignored, here too, and no knob
# re-enables them. A client that must cross a proxy uses an SSH tunnel, COORDINATOR_UDS
# or an allowlist. httpx trusts only certifi, never the OS store: for a private CA,
# terminate TLS so the URL is http://, or append the CA to that interpreter's certifi
# bundle. The backfill scripts (urllib), ops curl lines, the gateway's own session and
# the rerank shim still honour the environment, so a private CA on an https encoder
# needs both places; terminating TLS avoids that.
# Where an agent reaches the gateway. Override only if a tunnel maps a different local port.
# COORDINATOR_URL=http://localhost:8888

# DREAM_TEMPERATURE sets both; REM_TEMPERATURE / NREM_TEMPERATURE override per daemon.
# Local models: Gemma ~0.6, Mistral-3 Instruct/Qwen ~0.1, Mistral-3 Reasoning ~1.0.
# DREAM_TEMPERATURE=0.6

# NREM density sweep interval (safety net for clusters lacking triggering saves).
# NREM_SWEEP_INTERVAL_SEC=3600
# Length-finish fails unit: truncated drafts are never salvaged, persisted, or fed to
# gates. Solo and insight calls retry once at wider bounds. Truncated batches retain
# complete lines; missing facts count an attempt and return solo. Raise base, not factor.
# REM_MAX_TOKENS_SOLO=1500
# REM_MAX_TOKENS_PER_FACT=400
# REM_MAX_TOKENS_PER_SUMMARY=250
# REM_TRUNCATION_RETRY_FACTOR=2.0
# Degenerate truncated solos retry at same bound; honest ones wider. Diagnostic specimen
# chars kept in journal/metrics, never full body and never the record.
# REM_TRUNCATION_SPECIMEN_CHARS=500
# NREM insight output bound (8192 unmeasured). Too low truncates (truncation_failures);
# too high rejects small clusters ("fit-rejected").
# NREM_MAX_TOKENS_INSIGHT=8192
# NREM_TRUNCATION_RETRY_FACTOR=2.0

# Per-call ceiling floor (s) for dream calls: max(floor, prompt_chars/100, units*15,
# max_tokens/LLM_MIN_TOK_S).
# LLM_CEILING_FLOOR=600
# Keep max_tokens/LLM_MIN_TOK_S under NREM_FORCED_SLOT_WAIT, or folds outlast REM yields.
# LLM_MIN_TOK_S=10

# Dream call metrics (JSONL; unset = structured logs only).
# DREAM_METRICS_PATH=~/.shared-memory/logs/dream-metrics.jsonl
# BGE-M3 hard window: refuses larger inputs instead of truncating, so callers clamp.
# EMBED_MAX_CONTEXT_TOKENS=8192
# Conservative chars/token for clamp/timeout estimates. Lower errs safe.
# EMBED_CHARS_PER_TOKEN=3.0
#
# Special-token reserve subtracted from window [0, EMBED_MAX_CONTEXT_TOKENS).
# EMBED_SPECIAL_TOKEN_RESERVE=2
#
# Max embedder input: default (window - reserve) * chars_per_token = 24570.
# ⛔ LEFTOVER 24576 WARNING: older versions shipped EMBED_MAX_CHARS=24576 (zero reserve).
# Dense inputs produce 8192 tokens + BOS/EOS -> 8193 tokens, failing HTTP 400. Unset or
# lower any leftover 24576. Full text is always stored/returned; vector uses the slice.
# EMBED_MAX_CHARS=24570
# Slowest embedding rate for timeouts: set below observed floor, never average:
# throughput falls as input grows. A GPU embedder raises it.
# EMBED_MIN_TOK_S=100
# EMBED_SAFETY_FACTOR=1.5
# EMBED_TIMEOUT_FLOOR_S=20
# Max reranker chars per document. Full text is always stored and returned.
# ⛔ RETRIEVAL SELECTS ON THE EMBEDDING WINDOW, so ranking on a narrower slice can
# demote a record for lacking the very text it was selected for. Defaults to
# EMBED_MAX_CHARS so ranking and retrieval see identical text.
# Lower it only as a deliberate latency trade.
# RERANK_MAX_DOC_CHARS=24570
# Slowest reranker rate: set below observed floor, never average.
# RERANK_MIN_CHARS_S=800
#
# Margin over the derived time, and the floor for small payloads.
# RERANK_SAFETY_FACTOR=1.5
# RERANK_TIMEOUT_FLOOR_S=10
#
# ── Backend capability probing ───────────────────────────────────────────────
# /health reports whether backends SERVE via cached probe costing inference time.
# CAPABILITY_PROBE_INTERVAL_S=600
# CAPABILITY_PROBE_RETRY_S=15      # re-probe cadence while a backend is FAILING (unreachable); too_slow keeps the full interval
# CAPABILITY_PROBE_DOCS=4
# CAPABILITY_PROBE_DOC_CHARS=1000
#
# Clients size timeouts from probe. SEARCH_TIMEOUT_* in this file does nothing; those
# knobs live in the skill env. Capacity numbers are report-only (decision:1424);
# malformed values warn and use defaults without crashing. 30s is the measured
# tolerable wait on CPU encoders.
# CAPACITY_TOLERABLE_WAIT_S=30.0
#
# Observed-maximum basis sample threshold (default unmeasured).
# CAPACITY_PAYLOAD_MIN_SAMPLES=5
#
# Derivation log location and retention (<=0 keeps 1).
# CAPACITY_LOG_PATH=~/.shared-memory/capacity/derivations.jsonl
# CAPACITY_LOG_MAX_RECORDS=20
#
# Drift trigger when reranker chars/s leaves [1/factor, factor] of basis (<=1.0 disables).
# CAPACITY_DRIFT_BAND_FACTOR=2.0
#
# Report-only mirrors of client search_ceiling(); does not alter client timeouts.
# CAPACITY_SEARCH_TIMEOUT_S=0
# CAPACITY_SEARCH_TIMEOUT_FLOOR_S=30
# CAPACITY_SEARCH_TIMEOUT_MAX_S=300
# CAPACITY_SEARCH_TIMEOUT_FALLBACK_S=120
# CAPACITY_SEARCH_SAFETY_FACTOR=1.5
# CAPACITY_SEARCH_OVERHEAD_S=15
# Recommended memory allowances (accepts 8G, 512M, bytes, 8Gi); allowances, not
# measurements. Any unparseable value nulls the recommendation and logs.
# CAPACITY_NEO4J_FALLBACK_BYTES=8G
# CAPACITY_PG_MEM_ALLOWANCE_BYTES=4G
# CAPACITY_EMBEDDER_MEM_ALLOWANCE_BYTES=2G
# CAPACITY_GATEWAY_MEM_ALLOWANCE_BYTES=512M
# CAPACITY_OS_MEM_MARGIN_BYTES=1G
# Database host interface (loopback default: databases hold entire corpus and publishing
# leaves only passwords; change only for remote gateway over trusted network).
# DB_BIND=127.0.0.1

# Encoder host interface (default loopback: NEITHER SERVICE HAS AUTHENTICATION; change
# only for remote gateways over trusted networks).
# INFERENCE_BIND=127.0.0.1
# CPU threads per encoder container (two run concurrently; memory bandwidth
# saturates first).
# LLAMA_CPU_THREADS=4
#
# CPU encoders (0 or 1). Set 0 ONLY when hosted outside stack to prevent compose port
# races for :8070/:8071. With 0, EMBEDDER_URL and RERANKER_URL must point to them or
# saves fail.
# CPU_ENCODER_REPLICAS=1
#
# Intel Arc B580 (PCI 8086:e20b) uses intel-arc-b580.yaml, not started here; keep
# llama.cpp replicas at 0 and point EMBEDDER_URL to :8091 and RERANKER_URL to :8092
# so stacks do not clash.
# Vulkan pair defaults off. A card that fits the reasoning model is usually better spent
# there; a ~4 GB card is the one these encoders fit.
# GPU_ENCODER_REPLICAS=0
#
# Per-service replica overrides (~4 GB cards fit embedder but not reranker's 8192 window).
# Per-service knobs override the pair. Leave a value implicit and a later pair-wise
# edit moves that encoder.
# EMBEDDER_CPU_REPLICAS=1
# EMBEDDER_GPU_REPLICAS=0
# RERANKER_CPU_REPLICAS=1
# RERANKER_GPU_REPLICAS=0
# Replica counts determine device selection; no EMBEDDER_DEVICE knob
# (decision:1032: derive, do not copy).
# ENCODER_GPU_INDEX=0
#
# Render node group (`stat -c '%g' /dev/dri/renderD128`; derived by install_framework.sh).
# GPU_RENDER_GID=video

# Enrichment dead-letter cap (record-attributable failures only, never transport).
# Dead-lettered until n.rem_attempts is reset; watch rem_dead_lettered.
# REM_MAX_ATTEMPTS=5

# Summary request threshold (chars); shorter content remains verbatim.
# REM_SUMMARY_THRESHOLD=2000

# Solo starvation promotion threshold.
# REM_STARVED_THRESHOLD=3

# Fold dead-letter: clusters hitting truncation, slot, or embed failures this many
# times within the window are skipped rather than re-folded indefinitely.
# NREM_FOLD_FAIL_CAP=3
# NREM_FOLD_FAIL_WINDOW=7

# REM/NREM slot arbitration for shared serial LLM slot. NREM acquires advisory lock
# while queuing; REM yields. Wait budget MUST exceed longest REM unit or queue expires
# before REM completes. Both daemons must agree on key. REM re-arms faster and its solo
# units run for minutes, so without the arbiter consolidation can defer indefinitely.
# NREM_FORCED_SLOT_WAIT=1800
# NREM_PRIORITY_ADVISORY_LOCK_KEY=8765310

# Idle window before due consolidation fires (hard backstop is 3x this).
# NREM_IDLE_THRESHOLD_SEC=900
# NREM eligibility count recheck cadence (facts at rem_reviewed).
# NREM_ELIGIBILITY_RECHECK_SEC=60

# NREM idle-clock pool probe cadence (fail-open).
# NREM_POOL_PROBE_SEC=15
# Project name normalisation map at ingress (decision:276: folder name is canonical).
# PROJECT_ALIASES=shared_mem=my-project,shared_memory=my-project,old-name=my-project
# -------------------------------------------------------------

# Postgres pool: max_connections must cover POOL_MAX + REM(1) + NREM(per-op) + LISTEN
# + headroom. POOL_ACQUIRE_TIMEOUT sheds with 503 rather than hanging.
# POOL_MIN=2
# POOL_MAX=20
# POOL_ACQUIRE_TIMEOUT=5.0
# Postgres startup wait before exit so systemd restarts it (retry clamped to 0.1s floor).
# PG_STARTUP_WAIT_S=60.0
# PG_STARTUP_RETRY_S=2.0

# Shared Neo4j driver pool; acquisition timeout fails fast under contention.
# NEO4J_MAX_POOL=50
# NEO4J_ACQUIRE_TIMEOUT=30.0

# Failed-outbox exponential backoff (now + base*2^retries, capped/jittered) to prevent
# Neo4j outage retry storms.
# OUTBOX_BACKOFF_BASE=2.0
# OUTBOX_BACKOFF_MAX=300.0

# Alternative vector embedding sweep cadence and batch size. A latency knob: pending
# work is a committed row.
# ALT_VECTOR_POLL_INTERVAL=10.0
# ALT_VECTOR_BATCH_SIZE=32
# Failures before marking row `failing` (never a give-up threshold).
# ALT_VECTOR_FAILING_AFTER=5

# Per-entity write-lock LRU registry cap.
# LOCKS_MAX_SIZE=4096

# Advisory lock serialising fact supersessions (must differ from other lock keys;
# default 8765311).
# SUPERSEDE_LOCK_KEY=8765311

# Max in-flight requests at auth seam (0 disables; applies before exemptions,
# so /health can be shed).
# GATEWAY_INFLIGHT_MAX=100

# Upstream fan-out cache TTL for /health.
# HEALTH_CACHE_TTL_S=3

# GPU-aware dreaming via nvtop (SLOT_AWARE=0 falls back to WRITE_QUIESCE_SEC). Timed-out
# nvtop is SIGKILLed; probe disables until gateway restart after
# NVTOP_MAX_CONSECUTIVE_HANGS timeouts. Unmeasured.
# SLOT_AWARE=1
# NVTOP_BIN=nvtop
# NVTOP_TIMEOUT_SEC=5.0
# GPU_BUSY_PERCENT=50
# GPU_INDICES=0,1
# NVTOP_KILL_WAIT_SEC=1.0
# NVTOP_MAX_CONSECUTIVE_HANGS=3
# Stall threshold defaults to 2.5x NREM_SWEEP_INTERVAL_SEC so single deferred sweeps
# avoid false alerts.
# CONSOLIDATION_STALL_THRESHOLD_SEC=9000
# CONSOLIDATION_HEALTH_REFRESH_SEC=60
# CONSOLIDATION_ORPHAN_TIMEOUT_SEC=1800
# CONSOLIDATION_RUNS_RETENTION_DAYS=30
# Cache TTL for /memory/telemetry payload (generated_at tracks build timestamp).
# TELEMETRY_CACHE_S=15
# Compliance.top_paths full-graph recalculation interval (0 disables). Unmeasured.
# GRAPH_TOP_PATHS_REFRESH_S=300
#
# Sample rings for p50/p95. POOL_WAIT_WINDOW and NEO4J_LATENCY_WINDOW default to
# ENCODER_LATENCY_WINDOW. Unmeasured.
# ENCODER_LATENCY_WINDOW=200
# POOL_WAIT_WINDOW=200
# NEO4J_LATENCY_WINDOW=200
# BREAKDOWN_AXIS_TOP_N=50
#
# GATEWAY_LATENCY_WINDOW=500
#
# Flat encoder warning threshold (unset derives per encoder from probe; prefer unset).
# ENCODER_LATENCY_WARN_MS=
#
# Outbox age raising /health warning. Unmeasured.
# OUTBOX_AGE_WARN_S=3600
#
# Token verification failures/min triggering warning. Unmeasured.
# TOKEN_VERIFY_WARN_PER_MIN=10
#
# NREM fold attempts in 24h with 0 successes triggering degraded status. Unmeasured.
# NREM_FOLD_ATTEMPT_WARN=5
# Cap on tracked client versions (untrusted caller header).
# CLIENT_VERSIONS_MAX=64

# ── Backup (ops/backup.sh — gateway host only) ───────────────────────────────
# Admin-role token (/admin/* only) for backup.sh quiesce. Register digest via stdin,
# never argv:
#   printf '%s' tok_backup_xxx | uv run python shared-memory/scripts/generate_tokens.py --digest backup
#   AGENT_TOKENS=...,backup:sha256:<digest-of-tok_backup_xxx>
#   AGENT_ROLES=monitor:read,backup:admin
# BACKUP_ADMIN_TOKEN is the RAW plaintext token presented by backup.sh.
# BACKUP_ADMIN_TOKEN=tok_backup_xxx
# BACKUP_DIR=~/.shared-memory/backups
# BACKUP_RETENTION_DAYS=14
# BACKUP_QUIESCE_MAX_SECONDS=900     # gateway TTL auto-resume if the script dies
# BACKUP_DRAIN_MAX_SECONDS=120       # wait for the outbox to drain before dumping
# BACKUP_QUIESCE_REQUIRED=0          # 1 = abort if the gateway can't be quiesced
# Advisory-lock key shared by gateway + REM + NREM (change all three together):
# BACKUP_ADVISORY_LOCK_KEY=8765309
# Container names (compose defaults shown):
# PG_CONTAINER=postgres-vector
# NEO4J_CONTAINER=neo4j-memory

# update_framework.sh overrides (standard installs leave unset).
# GATEWAY_URL=http://localhost:8888
# GATEWAY_UNIT=hive-mind-gateway.service
# GATEWAY_RESTART_CMD=systemctl --user restart hive-mind-gateway.service
# LLM_BACKENDS_JSON is the sole backend declaration. Each entry requires url, n_ctx,
# and max_output_tokens (positive ints). priority is optional, default 1, shown and
# not used for routing yet. Leftover CSV or default-target names are ignored.
# token_env holds the variable NAME carrying the provider key, never the literal key.
# Deliver via <NAME>_FILE or LoadCredential= (see ops/README.md).
# Credentialed backends accept https or plaintext http over private paths: loopback,
# RFC1918, Tailscale CGNAT 100.64/10, link-local, ULA, unqualified hosts, or domains
# .local, .lan, .internal, .home, .home.arpa, .ts.net. Plaintext http to public
# addresses is excluded unless plaintext_ok asserts private path. Over plain HTTP
# a token gives little.
# Note: the gateway never sends a provider key in the clear across the internet.
# _FILE pointers are used verbatim (~ unexpanded). Runtime paths vanish on reboot;
# re-emit or backends drop out (if sole backend, dreaming stops with no error). Mode 0600
# is minimum, not recommended best practice. Control characters other than trailing
# CR/LF refuse keys and exclude backends. Check provider limits; do not copy examples.
# LLM_BACKENDS_JSON=[{"url":"http://localhost:5000","n_ctx":8192,"max_output_tokens":2048},{"url":"https://api.example/v1","token_env":"EXAMPLE_API_KEY","n_ctx":8192,"max_output_tokens":2048,"priority":1}]

# Pool failure/affinity tuning (details in ops/README.md):

# LLM_FAIL_THRESHOLD=2             # TRANSPORT fails within LLM_FAIL_WINDOW → cooldown
# LLM_FAIL_WINDOW=60
# LLM_COOLDOWN=300                 # seconds a failing backend sits out
# Upstream 429/5xx count toward cooldown on their own threshold
# (LLM_HTTP_FAIL_THRESHOLD); other 4xx never count. Success clears streak. Unmeasured.

# LLM_HTTP_FAIL_THRESHOLD=5
# ⛔ `bootstrap_tokens.sh --reveal` outputs live tokens and REFUSES when stdout is not
# a terminal (fact:1499: prevents disclosure in agent transcripts). Set ONLY to script
# headless reveals; treat output as disclosed. Shell-read only; ignored here.
# An install never needs it.
# SHARED_MEMORY_ALLOW_REVEAL_WITHOUT_TTY=1
# Backend liveness probe intervals (credentialed probe never shorter than
# uncredentialed). Unmeasured.

# LLM_PROBE_INTERVAL_S=3.0
# LLM_PROBE_INTERVAL_CREDENTIALED_S=30.0
# LLM_AFFINITY_PREFIX_CHARS=6144   # prompt-prefix length hashed for affinity
# LLM_AFFINITY_TTL=600             # seconds a warm-prefix mapping is trusted
# LLM_AFFINITY_MAX_INFLIGHT=4      # prefer the warm card up to this queue

# Capacity wait when backend specifies max_inflight (returns 503 after WAIT_S; POLL_S
# floor 0.05; WAITERS caps concurrent waiters (unmeasured); see ops/README.md).

# LLM_MAX_INFLIGHT_WAIT_S=120
# LLM_MAX_INFLIGHT_POLL_S=0.5
# LLM_MAX_CAPACITY_WAITERS=8

# Allowed framework callers for chat route when auth is on (with auth off, only spawned
# daemons reach the pool even if listed here). The old name is honoured for one
# release, with a warning.
# LLM_FRAMEWORK_AGENT_NAMES=
# Fit estimate parameters: chars/token ratio, n_ctx safety margin, and fallback tokens.
# LLM_CHARS_PER_TOKEN_RATIO=1.2
# FIT_MARGIN=0.10
# FIT_DEFAULT_OUTPUT_TOKENS=2048
# Response buffering/decompression caps for usage parsing (exceeding cap abandons count,
# never request). INTERVAL adds periodic summary lines (0 = shutdown only).

# LLM_USAGE_CAPTURE_CAP_BYTES=2097152
# LLM_USAGE_DECOMPRESS_CAP_BYTES=67108864
# TOKEN_LIFECYCLE_SUM_INTERVAL_S=0

# Model ID sent on reasoning calls (required for vLLM, TGI, routers, cloud,
# multi-model LM Studio).
# LLM_MODEL=local-model
# Encoder endpoints forwarded by gateway (clients never call directly). Model dimensions
# are fixed: vector(1024) is in the schema with no dimension guard; different dimensions
# require full RE-EMBED.
# EMBEDDER_URL=http://localhost:8070
# RERANKER_URL=http://localhost:8071
# Optional encoder key (literal value, *_FILE pointer, or $CREDENTIALS_DIRECTORY).
# Read at start, so restart after changing it. Refused keys mark embedder down and
# reranker degraded (auth_failed). Unset sends no key.
# EMBEDDER_API_KEY=
# RERANKER_API_KEY=
# Plain HTTP is the default. An encrypted tunnel (SSH or Tailscale) is expected,
# the same way a remote client reaches the gateway. A key on plain HTTP is
# readable on the path. Use https when the endpoint offers it. false withholds
# the key from a public plain-HTTP address.
# ENCODER_PLAINTEXT_OK=true
# vLLM serves /v1/rerank instead of /v1/reranking. The shim rewrites path only and
# forwards Authorization headers. Only read if running the shim. Loopback binding is
# default; binding wider publishes the reranking endpoint.
# SHIM_VLLM_URL=http://127.0.0.1:8090   # where vLLM's reranker listens (http or https)
# SHIM_HOST=127.0.0.1                   # what the shim binds (see below)
# SHIM_PORT=8092                        # then RERANKER_URL=http://127.0.0.1:8092
# SHIM_TIMEOUT_S=<unset>                # no deadline by default (the gateway's wait governs); set = positive seconds
# ⛔ NOT read by gateway or apply.py (they use PG_CONN and fixed Neo4j URI). Maintenance
# scripts read these; changing PG_HOST here forks script target from gateway, a known,
# unfixed fork.
# PG_HOST=localhost
# PG_PORT=5432
# PG_USER=postgres
# PG_DATABASE=agent_data
#
# verify_schema_init.py connection DB for throwaway comparison DB.
# PG_MAINTENANCE_DB=postgres
#
# Neo4j parameters for maintenance scripts touching graph.
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
#
# sync_project_registry.py cutoff for duplicate warnings.
# PROJECT_CLOSE_MATCH_CUTOFF=0.6
#
# sync_project_registry.py search roots (os.pathsep-separated; empty: pass --roots).
# PROJECT_ROOTS=
# ⛔ THE ACTUAL DATABASE CONFIGURATION, read by the gateway and apply.py.
# This repository is public: never write a real DSN here. Placeholder shape:
# PG_CONN=postgresql://USER:PASSWORD@HOST:5432/DBNAME


# Trigram similarity threshold holding new sections as typos (>0 and <=1; invalid
# stops gateway).
# DOMAIN_CONFUSABLE_SIMILARITY=0.6

# Trigram similarity for entity names at save (>0 and <=1; invalid stops gateway).
# ENTITY_CONFUSABLE_SIMILARITY=0.6

# Trigram similarity for project names. Not range-checked; a non-number stops the gateway.
# PROJECT_CONFUSABLE_SIMILARITY=0.6

# Noise filter minimum entity name length.
# MIN_ENTITY_NAME_LEN=2

# entity_fragment_rate.py max plausible entity name words.
# MAX_ENTITY_NAME_WORDS=4

# REM temperature (falls back to DREAM_TEMPERATURE, then 0.6).
# REM_TEMPERATURE=0.6

# NREM temperature (falls back to DREAM_TEMPERATURE, then 0.6).
# NREM_TEMPERATURE=0.6

# Insight slot prompt input character limit from judgment bodies.
# NREM_INSIGHT_SLOT_INPUT_CHARS=2000

# REM yield duration to write bursts when SLOT_AWARE is off.
# WRITE_QUIESCE_SEC=30

# Max encoder POST body buffered (returns HTTP 413 above this).
# EMBED_RERANK_BUFFER_CAP=1048576

# Idle seconds before suspecting backend wedge.
# LLM_WEDGE_SUSPECT_AGE=900

# Max secret file size read before refusal.
# SECURE_ENV_SECRET_FILE_MAX_BYTES=65536

# Custom ontology.yaml location.
# SMEM_ONTOLOGY_PATH=

# ⛔ DEPRECATED: derived from GATEWAY_URL by migrate_retro_edges.py (warns on use).
# EMBED_URL=

# pool_status.py status endpoint.
# POOL_STATUS_URL=http://localhost:8888/pool/status

# Max entity name length in saves before refusal.
# ENTITY_NAME_MAX_LEN=200

# Max entities allowed per save.
# ENTITY_LIST_MAX_LEN=50

# Candidate entity proposals per record in REM.
# ENTITY_PROPOSAL_LIMIT=5

# Graph edges per anchored record in search results.
# GRAPH_EXPANSION_LIMIT=15

# Lineage reply neighbor cap.
# LINEAGE_RELATED_CAP=50

# /memory/graph row limit (returns HTTP 400 above this).
# GRAPH_QUERY_ROW_CAP=10000

# Tier-1 candidates floor for reranking: max(floor, caller limit).
# SEARCH_CANDIDATE_FLOOR=20

# Max `domains` filter entries (REFUSED above cap, never truncated, as partials mislead).
# SEARCH_DOMAINS_FILTER_CAP=16

# Max references named in search-by-ref calls.
# SEARCH_REFS_CAP=16

# Retry-After header value (seconds) for writes shed during backup quiesce.
# BACKUP_RETRY_AFTER=30
