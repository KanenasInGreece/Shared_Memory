# =============================================================
# Shared Memory Framework — FRAMEWORK Configuration
#
# This is the FRAMEWORK env. It lives in the framework folder and is read by
# the gateway/daemons AND by docker-compose (data paths + DB passwords below):
#     shared-memory/.env         ← live values (gitignored, NEVER commit)
#     shared-memory/.env.example ← this sanitized template (committed)
# The CLIENT token lives separately in the skill folder's .env (AGENT_TOKEN);
# see shared-memory-skill/shared-memory/.env.example.
#
# First-time setup: run  bash shared-memory/scripts/install_framework.sh
# (prompts for the values below, writes shared-memory/.env, creates data dirs).
# Or copy this file to shared-memory/.env and fill in the values by hand.
# =============================================================
# Neo4j host dir. Compose mounts data, logs, import and plugins under it. No trailing slash.
NEO4J_HOST_DIR=/your/data/path/neo4j
# Postgres data dir.
PG_DATA_DIR=/your/data/path/postgres
# GGUF directory for the bundled embedder and reranker. Leave it when another server already serves those models.
LLM_MODELS_DIR=/path/to/your/LLM_Models

# Model file layout under LLM_MODELS_DIR. Set LLM_MODELS_DIR absolute: a relative path resolves against shared-memory/ops/, not your shell's cwd.

# EMBED_MODEL_SUBPATH=gpustack/bge-m3-GGUF/bge-m3-Q8_0.gguf
# RERANK_MODEL_SUBPATH=gpustack/bge-reranker-v2-m3-GGUF/bge-reranker-v2-m3-Q8_0.gguf
# -------------------------------------------------------------
# Neo4j memory. Neo4j REFUSES to boot when heap max + pagecache exceed physical RAM, so a host under ~8 GB lowers these here, never in the tracked yaml. Small-host preset:
# NEO4J_HEAP_INITIAL=256M
# NEO4J_HEAP_MAX=512M
# NEO4J_PAGECACHE=256M

# Secrets — you must set these. A name ending _PASSWORD/_TOKEN/_API_KEY/_SECRET/_KEY/_CREDENTIAL(S) can also come from $CREDENTIALS_DIRECTORY or a _FILE pointer, and neither is copied into a child environment. An exported key itself still wins and logs an advisory.
# Setting the _FILE pointer is what makes that key a candidate. A pointer for a name that is not secret-shaped is ignored. A non-absolute path does not resolve.
# PG_PASSWORD_FILE=/run/secrets/pg_password
# One balanced pair of surrounding quotes is stripped. A value you quoted expecting the quotes to be part of it is now read without them.
NEO4J_PASSWORD=your-neo4j-password-here
PG_PASSWORD=your-postgres-password-here

# Optional — only if you use the LM Studio web-search MCP. README §16.
# Consumed by mcp.json → tavily-mcp; the Python stack does not read it.
# Ships commented out: an install that skips web search should not carry a
# live placeholder value.
# TAVILY_API_KEY=your-tavily-api-key-here
# -------------------------------------------------------------
# GATEWAY .env: the agent token registry, from generate_tokens.py. Unset means auth off. Format name:sha256:<64 hex>, comma-separated; a plaintext entry makes the gateway REFUSE TO START.
# Leave this commented. bootstrap_tokens.sh's own write is the only live assignment this file should carry. A second live line worked only because the parser takes the last one.
# AGENT_TOKENS=
# GATEWAY .env: S-05 (decision:1303). AGENT_TOKENS unset with a backend whose token_env resolved makes the gateway REFUSE TO START, because auth-off leaves the in-flight cap and the audit path off. Configure AGENT_TOKENS, or set this to accept that deliberately. With auth off, only a spawned daemon reaches the chat route. With AGENT_TOKENS set, LLM_FRAMEWORK_AGENT_NAMES entries are admitted too.
# ALLOW_UNAUTHENTICATED_PROVIDER_KEYS=1
# GATEWAY .env: optional read-only roles. A read token may reach
# GET /memory/telemetry, POST /memory/search, and GET /memory/status/{pg_id};
# POST /memory/graph is 403; GET /health is anonymous (not a read-role grant).
# Use for ops clients that must observe but never write, e.g.
# the shared-memory-monitor dashboard.
# Empty / unset = full read/write for an ordinary name, but a read-only roster name
# (built-in `monitor`, or SHARED_MEMORY_READ_ONLY_AGENTS) is always read and
# `maintenance-admin` is admin unless declared read.
# Format: comma-separated name:role pairs; role is "read", "full" or "admin"
# (admin = /admin/* only, e.g. backup:admin).
# AGENT_ROLES=monitor:read
# GATEWAY .env: extra names confined to read-only routes. It adds to the roster and can never widen a read-only identity. A name containing `:`, a newline or a carriage return makes the bulk mint refuse.
# SHARED_MEMORY_READ_ONLY_AGENTS=

# Where each local agent's skill .env lives, so a mint can write the token there. A missing name is remote: use generate_tokens.py --reveal. The name splits on the first colon; `name:path` is kind skill forever, and `name:kind:path` is how mcp is registered. Leave this commented: a live empty line is not the assignment bootstrap_tokens.sh should write.
#   AGENT_INSTALLS=claude:/home/you/.claude/skills/shared-memory/.env,opencode:mcp:/home/you/.config/opencode/shared-memory-mcp/.env
# AGENT_INSTALLS=

# AGENT skill .env (NOT the gateway): this agent's own token. Each agent
# uses a distinct token — never shared. LM Studio: set it in the mcp.json
# env block instead, then restart LM Studio.
# AGENT_TOKEN=tok_change_me_abc123
# -------------------------------------------------------------
MEMORY_LOG_LEVEL=0

# Directory for per-tool logs, merged daily by the consolidation daemon.
MEMORY_LOG_PATH=~/.shared-memory/logs

# REM outbox audit log (JSON-lines, one entry per reviewed outbox row),
# written by rem_loop.py. Empty = disabled (default). Never auto-rotated.
AUDIT_LOG_PATH=
# Gateway per-request audit log (JSON-lines). Empty disables it. Not rotated.
# GATEWAY_AUDIT_LOG_PATH=~/.shared-memory/logs/gateway-audit.jsonl
# Credential-events log (JSON-lines), on by default; an empty string disables it. Key rejections, gateway faults on credentialed calls, token-verify failures (rate-limited) and daemon-token mints. Never the token or key value. Rotation needs ops/shared-memory-logrotate.timer.
# CREDENTIAL_AUDIT_LOG_PATH=~/.shared-memory/logs/credential-audit.jsonl
# TOKEN_VERIFY_FAILED_LOG_RATE=60
# TOKEN_VERIFY_FAILED_LOG_WINDOW=60
# -------------------------------------------------------------

# Person identity. The gateway stamps `principal` from the kernel (SO_PEERCRED), never from the request, so an agent cannot forge it. It needs the AF_UNIX listener; over TCP it is absent.
#
# Gateway Unix socket. Default $XDG_RUNTIME_DIR/shared-memory-gw.sock. = disables it; a multi-user gateway sets a shared path and widens the mode.
# GATEWAY_UDS_PATH=
# GATEWAY_UDS_MODE=0600
#
# Reject write routes with no kernel-attested principal. Turn on once every writer uses the socket.
# GATEWAY_REQUIRE_PRINCIPAL=0
#
# Client side: the socket memory_bridge connects over. = forces TCP. Must match GATEWAY_UDS_PATH.
# COORDINATOR_UDS=

# Network interface the gateway binds to. README §9 / SECURITY.md.
# Default 127.0.0.1 (localhost only). Set 0.0.0.0 ONLY behind an encrypted
# overlay (Tailscale / WireGuard / TLS) — bearer tokens are plaintext over HTTP.
# PROXY_BIND=127.0.0.1
# Every httpx client uses trust_env=False, so HTTP_PROXY, HTTPS_PROXY, ALL_PROXY, NO_PROXY, SSL_CERT_FILE and SSL_CERT_DIR are ignored, here too, and no knob re-enables them. A client that must cross a proxy uses an SSH tunnel, COORDINATOR_UDS or an allowlist. httpx trusts only certifi, never the OS store: for a private CA, terminate TLS so the URL is http://, or append the CA to that interpreter's certifi bundle. The backfill scripts (urllib), ops curl lines, the gateway's own session and the rerank shim still honour the environment, so a private CA on an https encoder needs both places; terminating TLS avoids that.
# Where an agent reaches the gateway. Override only if a tunnel maps a different local port.
# COORDINATOR_URL=http://localhost:8888

# Dreaming LLM sampling temperature (REM enrichment + NREM consolidation).
# Per-daemon: REM_TEMPERATURE / NREM_TEMPERATURE; DREAM_TEMPERATURE sets both. Default 0.6.
# Tune per local model: Gemma ~0.6, Mistral-3 Instruct/Qwen ~0.1, Mistral-3 Reasoning ~1.0.
# DREAM_TEMPERATURE=0.6

# Seconds between NREM's density sweeps, the safety net for clusters with no triggering save.
# NREM_SWEEP_INTERVAL_SEC=3600
# A length-finish fails the unit: a truncated draft is never salvaged, persisted or fed to a gate. A REM solo call and an NREM insight call retry once at a wider bound. A truncated REM batch keeps its complete lines; each missing fact is charged an attempt and returns solo. Raise the base bound, not the factor.
# REM_MAX_TOKENS_SOLO=1500
# REM_MAX_TOKENS_PER_FACT=400
# REM_MAX_TOKENS_PER_SUMMARY=250
# REM_TRUNCATION_RETRY_FACTOR=2.0
# A degenerate truncated solo retries at the same bound, an honest one wider. This many trailing characters are kept for diagnosis in the journal and metrics, never the full body and never the record.
# REM_TRUNCATION_SPECIMEN_CHARS=500
# Output bound of NREM's insight call. 8192 has no measured basis. Too low truncates (truncation_failures); too high makes the fit check refuse small clusters ("fit-rejected"). Raising it helps the first and worsens the second.
# NREM_MAX_TOKENS_INSIGHT=8192
# NREM_TRUNCATION_RETRY_FACTOR=2.0

# Per-call ceiling (seconds) for a dream LLM call: the largest of this floor, prompt_chars/100, work_units*15, and max_tokens/LLM_MIN_TOK_S.
# LLM_CEILING_FLOOR=600
# Keep max_tokens/LLM_MIN_TOK_S under NREM_FORCED_SLOT_WAIT, or a long fold outlasts REM's willingness to yield the slot.
# LLM_MIN_TOK_S=10

# Optional JSONL file with one row per dream LLM call. Unset means structured logging only.
# DREAM_METRICS_PATH=~/.shared-memory/logs/dream-metrics.jsonl
# BGE-M3's hard window. It refuses a larger input instead of truncating, so every caller clamps.
# EMBED_MAX_CONTEXT_TOKENS=8192
# Conservative characters per token, for the clamp and the estimate. Low errs safe: earlier truncation, longer timeout.
# EMBED_CHARS_PER_TOKEN=3.0
#
# Special-token reserve subtracted from the window. Range [0, EMBED_MAX_CONTEXT_TOKENS).
# EMBED_SPECIAL_TOKEN_RESERVE=2
#
# Longest input sent to the embedder. Default (window - reserve) * chars per token = 24570.
# ⛔ LEFTOVER 24576 WARNING: older versions shipped EMBED_MAX_CHARS=24576 (zero reserve).
# On dense inputs, 24576 chars produces 8192 tokens + BOS/EOS -> 8193 tokens, failing with
# HTTP 400. If upgrading, unset or lower any leftover EMBED_MAX_CHARS=24576 in your .env.
# The full text is always stored and returned; only the vector uses the slice.
# EMBED_MAX_CHARS=24570
# Slowest embedding rate the timeout sits through. Set it under your observed floor, never your average: throughput falls as input grows. A GPU embedder raises it.
# EMBED_MIN_TOK_S=100
# EMBED_SAFETY_FACTOR=1.5
# EMBED_TIMEOUT_FLOOR_S=20
# Longest text sent to the reranker per document, a relevance window. The full text is still stored and returned.
# ⛔ RETRIEVAL SELECTS ON THE EMBEDDING WINDOW, so ranking on a narrower slice can
# demote a record for lacking the very text it was selected for.
# Defaults to EMBED_MAX_CHARS so ranking and retrieval see the same text. Lower
# it only as a deliberate latency trade.
# RERANK_MAX_DOC_CHARS=24570
# Slowest reranking rate the timeout sits through. Under your observed floor, never your average.
# RERANK_MIN_CHARS_S=800
#
# Margin over the derived time, and the floor for small payloads.
# RERANK_SAFETY_FACTOR=1.5
# RERANK_TIMEOUT_FLOOR_S=10
#
# ── Backend capability probing ───────────────────────────────────────────────
# /health reports whether critical backends can SERVE, from a cached background probe that costs real inference time.
# CAPABILITY_PROBE_INTERVAL_S=600
# CAPABILITY_PROBE_RETRY_S=15      # re-probe cadence while a backend is FAILING (unreachable); too_slow keeps the full interval
# CAPABILITY_PROBE_DOCS=4
# CAPABILITY_PROBE_DOC_CHARS=1000
#
# Clients size search timeout from the probe. SEARCH_TIMEOUT_* in this file does nothing; those knobs live in the skill env.
# Capacity numbers are a report only (decision:1424). A malformed CAPACITY_* value warns and uses the default; it does not crash the gateway. 30s is the measured wait people actually worked with on the CPU encoders.
# CAPACITY_TOLERABLE_WAIT_S=30.0
#
# Observed-maximum basis after this many samples; the default is unmeasured.
# CAPACITY_PAYLOAD_MIN_SAMPLES=5
#
# Where records persist and how many are kept. A value <= 0 keeps one.
# CAPACITY_LOG_PATH=~/.shared-memory/capacity/derivations.jsonl
# CAPACITY_LOG_MAX_RECORDS=20
#
# probe_drift fires when reranker chars/s leaves [1/factor, factor] of the stored basis. A factor of 1.0 or lower disables the trigger.
# CAPACITY_DRIFT_BAND_FACTOR=2.0
#
# Report-only mirror of the client's search_ceiling() (client_ceiling_s). These do not change any client's timeout.
# CAPACITY_SEARCH_TIMEOUT_S=0
# CAPACITY_SEARCH_TIMEOUT_FLOOR_S=30
# CAPACITY_SEARCH_TIMEOUT_MAX_S=300
# CAPACITY_SEARCH_TIMEOUT_FALLBACK_S=120
# CAPACITY_SEARCH_SAFETY_FACTOR=1.5
# CAPACITY_SEARCH_OVERHEAD_S=15
# Memory-limit recommendation allowances, not measurements. Accepts 8G, 512M, bytes, 8Gi. One unparseable value nulls the whole recommendation; the gateway log names it.
# CAPACITY_NEO4J_FALLBACK_BYTES=8G
# CAPACITY_PG_MEM_ALLOWANCE_BYTES=4G
# CAPACITY_EMBEDDER_MEM_ALLOWANCE_BYTES=2G
# CAPACITY_GATEWAY_MEM_ALLOWANCE_BYTES=512M
# CAPACITY_OS_MEM_MARGIN_BYTES=1G
# Host interface for Postgres and Neo4j. Loopback by default: they hold the whole corpus and publishing them leaves only the password. Change it only if the gateway is on another host, over a network you trust.
# DB_BIND=127.0.0.1

# Host interface for the encoder ports. Loopback by default: NEITHER SERVICE HAS ANY AUTHENTICATION. Change it only for a remote gateway, over a network you trust.
# INFERENCE_BIND=127.0.0.1
# CPU threads per encoder container. Two can run at once; memory bandwidth saturates first.
# LLAMA_CPU_THREADS=4
#
# CPU-encoder containers (0 or 1). Set 0 ONLY when the encoders are hosted outside the stack, so `docker compose up` cannot race them for :8070/:8071. With 0, EMBEDDER_URL and RERANKER_URL must point at them, or saves are refused.
# CPU_ENCODER_REPLICAS=1
#
# Intel Arc B580 (PCI 8086:e20b) is a different file, intel-arc-b580.yaml, and is not started here. Keep the llama.cpp replicas at 0 and point EMBEDDER_URL at :8091 and RERANKER_URL at :8092, or the two stacks fight for the ports.
# The Vulkan pair in this file is off by default. A card that fits the reasoning model is usually better spent there; a ~4 GB card is the one these encoders fit.
# GPU_ENCODER_REPLICAS=0
#
# Per-service knobs override the pair. On a ~4 GB card the embedder fits and the reranker's 8192 window does not. Leave a value implicit and a later pair-wise edit moves that encoder.
# EMBEDDER_CPU_REPLICAS=1
# EMBEDDER_GPU_REPLICAS=0
# RERANKER_CPU_REPLICAS=1
# RERANKER_GPU_REPLICAS=0
# No EMBEDDER_DEVICE: the replica vars are the device choice (decision:1032, derive, do not copy).
# ENCODER_GPU_INDEX=0
#
# Group owning the render node (`stat -c '%g' /dev/dri/renderD128`). install_framework.sh derives it; this matters only for a manual edit.
# GPU_RENDER_GID=video

# A record whose enrichment fails this often is dead-lettered until n.rem_attempts is reset. Only record-attributable failures count, never a transport failure. Watch rem_dead_lettered.
# REM_MAX_ATTEMPTS=5

# A summary is requested only when content exceeds this many chars; shorter records stay verbatim.
# REM_SUMMARY_THRESHOLD=2000

# A solo record passed over this often is promoted to the starved sub-queue.
# REM_STARVED_THRESHOLD=3

# Fold dead-letter: a cluster that hits a truncation, slot or embed failure this many times within the window is skipped rather than re-folded forever.
# NREM_FOLD_FAIL_CAP=3
# NREM_FOLD_FAIL_WINDOW=7

# REM/NREM slot arbitration. The two dream daemons share one serial LLM slot.
# REM re-arms faster and its solo units run for minutes, so without an arbiter
# consolidation can defer indefinitely. NREM takes a well-known advisory lock
# while queuing for the slot and REM yields its turn. The wait budget MUST
# exceed your longest REM unit or the queue expires before REM ever finishes.
# Both daemons must agree on the lock key.
# NREM_FORCED_SLOT_WAIT=1800
# NREM_PRIORITY_ADVISORY_LOCK_KEY=8765310

# Idle window before a due consolidation fires. The hard backstop is 3x this.
# NREM_IDLE_THRESHOLD_SEC=900
# Seconds between NREM's reads of its eligibility count (facts at rem_reviewed).
# NREM_ELIGIBILITY_RECHECK_SEC=60

# Seconds between NREM's idle-clock probes of the pool. Fail-open.
# NREM_POOL_PROBE_SEC=15
# Project-name normalisation (decision:276: canonical project is the folder name).
# The coordinator rewrites the project through this alias map at ingress.
# PROJECT_ALIASES=shared_mem=my-project,shared_memory=my-project,old-name=my-project
# -------------------------------------------------------------

# Postgres pool. pg max_connections must cover POOL_MAX + REM (1) + NREM (per-op) + the LISTEN connection + headroom. POOL_ACQUIRE_TIMEOUT sheds with 503 rather than hanging.
# POOL_MIN=2
# POOL_MAX=20
# POOL_ACQUIRE_TIMEOUT=5.0
# Startup wait for Postgres, then exit so systemd restarts it. Retry is clamped to a 0.1s floor.
# PG_STARTUP_WAIT_S=60.0
# PG_STARTUP_RETRY_S=2.0

# Neo4j driver pool (gateway + both daemons share Neo4j). Bounds queueing under
# concurrent search/daemon contention; acquisition timeout fails fast.
# NEO4J_MAX_POOL=50
# NEO4J_ACQUIRE_TIMEOUT=30.0

# Failed-outbox retry backoff (per row): next_attempt_at = now + base·2^retries
# (capped, jittered). Stops a Neo4j outage becoming a 2 s-cycle retry storm.
# OUTBOX_BACKOFF_BASE=2.0
# OUTBOX_BACKOFF_MAX=300.0

# Seconds between sweeps embedding stored alternatives. A latency knob: pending work is a committed row.
# ALT_VECTOR_POLL_INTERVAL=10.0
# ALT_VECTOR_BATCH_SIZE=32
# Failures after which a row reads `failing`. Never a give-up threshold.
# ALT_VECTOR_FAILING_AFTER=5

# Per-entity write-lock registry cap (LRU).
# LOCKS_MAX_SIZE=4096

# Advisory lock serialising fact supersession transactions (must differ from BACKUP_ADVISORY_LOCK_KEY and the other advisory lock ids; default 8765311):
# SUPERSEDE_LOCK_KEY=8765311

# Max in-flight requests at the auth seam; 0 disables. Applies before every auth exemption, so /health can be shed.
# GATEWAY_INFLIGHT_MAX=100

# TTL of /health's cached upstream fan-out.
# HEALTH_CACHE_TTL_S=3

# GPU-aware dreaming (the nvtop probe). SLOT_AWARE=0 falls back to WRITE_QUIESCE_SEC. A timed-out nvtop is SIGKILLed; after NVTOP_MAX_CONSECUTIVE_HANGS timeouts the probe disables itself until the gateway restarts. Unmeasured.
# SLOT_AWARE=1
# NVTOP_BIN=nvtop
# NVTOP_TIMEOUT_SEC=5.0
# GPU_BUSY_PERCENT=50
# GPU_INDICES=0,1
# NVTOP_KILL_WAIT_SEC=1.0
# NVTOP_MAX_CONSECUTIVE_HANGS=3
# STALL_THRESHOLD defaults to 2.5× NREM_SWEEP_INTERVAL_SEC (the insight cycle
# rides every sweep) so a single deferred/failed sweep never trips the alert.
# CONSOLIDATION_STALL_THRESHOLD_SEC=9000
# CONSOLIDATION_HEALTH_REFRESH_SEC=60
# CONSOLIDATION_ORPHAN_TIMEOUT_SEC=1800
# CONSOLIDATION_RUNS_RETENTION_DAYS=30
# Seconds /memory/telemetry may serve one cached payload. generated_at says when that payload was built.
# TELEMETRY_CACHE_S=15
# Seconds between recomputes of compliance.top_paths, a scan of every relationship. 0 turns it off. Unmeasured.
# GRAPH_TOP_PATHS_REFRESH_S=300
#
# Sample rings for the p50/p95. Unmeasured.
# ENCODER_LATENCY_WINDOW=200
# Default to ENCODER_LATENCY_WINDOW.
# POOL_WAIT_WINDOW=200
# NEO4J_LATENCY_WINDOW=200
# BREAKDOWN_AXIS_TOP_N=50
#
# GATEWAY_LATENCY_WINDOW=500
#
# Flat encoder warning limit. Unset derives it per encoder from the capability probe; prefer that.
# ENCODER_LATENCY_WARN_MS=
#
# Outbox age raising a /health warning. Unmeasured.
# OUTBOX_AGE_WARN_S=3600
#
# Failed verifications per minute raising a warning. Unmeasured.
# TOKEN_VERIFY_WARN_PER_MIN=10
#
# NREM reads degraded at this many folds attempted in 24 h with none succeeded. Unmeasured.
# NREM_FOLD_ATTEMPT_WARN=5
# Cap on tracked client versions, because the value comes from a caller's header.
# CLIENT_VERSIONS_MAX=64

# ── Backup (ops/backup.sh — gateway host only) ───────────────────────────────
# An admin-role token lets backup.sh quiesce the gateway; it is confined to /admin/*. You choose the value and register its digest, read from stdin, never argv:
#   printf '%s' tok_backup_xxx | uv run python shared-memory/scripts/generate_tokens.py --digest backup
#   AGENT_TOKENS=...,backup:sha256:<digest-of-tok_backup_xxx>
#   AGENT_ROLES=monitor:read,backup:admin
# BACKUP_ADMIN_TOKEN is the RAW token backup.sh presents, the plaintext the digest was hashed from.
# BACKUP_ADMIN_TOKEN=tok_backup_xxx
# BACKUP_DIR=~/.shared-memory/backups
# BACKUP_RETENTION_DAYS=14
# BACKUP_QUIESCE_MAX_SECONDS=900     # gateway TTL auto-resume if the script dies
# BACKUP_DRAIN_MAX_SECONDS=120       # wait for the outbox to drain before dumping
# BACKUP_QUIESCE_REQUIRED=0          # 1 = abort if the gateway can't be quiesced
# Advisory-lock key shared by gateway + REM + NREM (change all three together):
# BACKUP_ADVISORY_LOCK_KEY=8765309
# Container / DB names (compose defaults shown):
# PG_CONTAINER=postgres-vector
# NEO4J_CONTAINER=neo4j-memory

# update_framework.sh. A standard install sets none of these. GATEWAY_RESTART_CMD exists for another supervisor.
# GATEWAY_URL=http://localhost:8888
# GATEWAY_UNIT=hive-mind-gateway.service
# GATEWAY_RESTART_CMD=systemctl --user restart hive-mind-gateway.service
# LLM_BACKENDS_JSON is the only declaration. Each entry needs url, n_ctx and max_output_tokens, positive integers. priority is optional, default 1, shown and not used for routing yet.
# A leftover CSV or default-target name is ignored.
# token_env holds the NAME of the variable that carries the provider key, never the key.
# Deliver that variable with <NAME>_FILE or systemd LoadCredential=. The walkthrough, including what counts as a private path, is ops/README.md.
# A credentialed entry is accepted over https, or over plaintext http on a private path: loopback, RFC1918, Tailscale CGNAT 100.64/10, link-local, ULA, an unqualified host name, or a name under .local, .lan, .internal, .home, .home.arpa, or .ts.net. A credentialed entry over plaintext http to a public address is excluded unless plaintext_ok asserts the path is private. Over plain HTTP a token gives little.
# Note: the gateway never sends a provider key in the clear across the internet.
# A _FILE pointer is used verbatim (~ is not expanded). A runtime path vanishes on reboot, so re-emit it or the backend drops out. Where that backend is the only one, dreaming stops with no error. A plain mode-600 file is the minimum, not the recommendation. A control character other than a trailing CR/LF refuses the key and excludes that backend.
# One localhost backend, and one online example. Check your provider's published limits. Do not copy the online numbers.
# LLM_BACKENDS_JSON=[{"url":"http://localhost:5000","n_ctx":8192,"max_output_tokens":2048},{"url":"https://api.example/v1","token_env":"EXAMPLE_API_KEY","n_ctx":8192,"max_output_tokens":2048,"priority":1}]

# Pool failure/affinity tuning — defaults fine, details in ops/README.md:

# LLM_FAIL_THRESHOLD=2             # TRANSPORT fails within LLM_FAIL_WINDOW → cooldown
# LLM_FAIL_WINDOW=60
# LLM_COOLDOWN=300                 # seconds a failing backend sits out
# An upstream 429 or 5xx counts toward cooldown on its own threshold. Other 4xx never counts. A success clears the streak. Unmeasured.

# LLM_HTTP_FAIL_THRESHOLD=5
# ⛔ `bootstrap_tokens.sh --reveal` prints a live bearer token and REFUSES when stdout is not a terminal (fact:1499: published steps once put one in an agent transcript). Set this ONLY to script a reveal on a host with no terminal, and treat the output as disclosed. An install never needs it. Read from the shell only; here it does nothing.
# SHARED_MEMORY_ALLOW_REVEAL_WITHOUT_TTY=1
# Seconds between backend liveness probes. LLM_PROBE_INTERVAL_CREDENTIALED_S is never shorter than LLM_PROBE_INTERVAL_S. Unmeasured.

# LLM_PROBE_INTERVAL_S=3.0
# LLM_PROBE_INTERVAL_CREDENTIALED_S=30.0
# LLM_AFFINITY_PREFIX_CHARS=6144   # prompt-prefix length hashed for affinity
# LLM_AFFINITY_TTL=600             # seconds a warm-prefix mapping is trusted
# LLM_AFFINITY_MAX_INFLIGHT=4      # prefer the warm card up to this queue

# Capacity wait (only if a backend declares max_inflight). WAIT_S then 503;
# POLL_S floor 0.05; WAITERS caps concurrent waiting requests (unmeasured
# shape-chosen bound — rationale in ops/README.md):

# LLM_MAX_INFLIGHT_WAIT_S=120
# LLM_MAX_INFLIGHT_POLL_S=0.5
# LLM_MAX_CAPACITY_WAITERS=8

# Other framework callers, by name, that may use the chat route when auth is on. On an auth-off install only a spawned daemon reaches the pool, even if listed. The old name is honoured for one release, with a warning.
# LLM_FRAMEWORK_AGENT_NAMES=
# Fit estimate. LLM_CHARS_PER_TOKEN_RATIO is characters per token. FIT_MARGIN is the fraction of n_ctx held back. FIT_DEFAULT_OUTPUT_TOKENS is the output budget when the request names no max_tokens.
# LLM_CHARS_PER_TOKEN_RATIO=1.2
# FIT_MARGIN=0.10
# FIT_DEFAULT_OUTPUT_TOKENS=2048
# Caps on buffering and inflating a response for the usage parse (over it, the count is abandoned, never the request). INTERVAL adds periodic sum lines; 0 = shutdown only.

# LLM_USAGE_CAPTURE_CAP_BYTES=2097152
# LLM_USAGE_DECOMPRESS_CAP_BYTES=67108864
# TOKEN_LIFECYCLE_SUM_INTERVAL_S=0

# Model id on every reasoning call. Set the real id for a backend that validates it (vLLM, TGI, a router, a cloud endpoint, LM Studio with several models).
# LLM_MODEL=local-model
# Encoder endpoints the gateway forwards to. Clients never call them directly. The model is a fixed contract: vector(1024) is in the schema with no dimension guard, and a different-dimension model requires a full RE-EMBED.
# EMBEDDER_URL=http://localhost:8070
# RERANKER_URL=http://localhost:8071
# Optional encoder key, resolved like a cloud LLM key (the value, a *_FILE pointer, or $CREDENTIALS_DIRECTORY). Read at start, so restart after changing it. A key the encoder refuses is auth_failed: embedder down, reranker degraded. Unset, nothing is sent.
# EMBEDDER_API_KEY=
# RERANKER_API_KEY=
# Plain HTTP is the default. An encrypted tunnel (SSH or Tailscale) is expected, the same way a remote client reaches the gateway. A key on plain HTTP is readable on the path. Use https when the endpoint offers it. false withholds the key from a public plain-HTTP address.
# ENCODER_PLAINTEXT_OK=true
# vLLM serves rerank on a different path. The shim rewrites the path only and forwards Authorization when one came. Nothing below is read unless you run that shim. The shim stays on loopback; binding it wider publishes the reranking endpoint.
# SHIM_VLLM_URL=http://127.0.0.1:8090   # where vLLM's reranker listens (http or https)
# SHIM_HOST=127.0.0.1                   # what the shim binds (see below)
# SHIM_PORT=8092                        # then RERANKER_URL=http://127.0.0.1:8092
# SHIM_TIMEOUT_S=<unset>                # no deadline by default (the gateway's wait governs); set = positive seconds
# ⛔ NOT read by the gateway or apply.py, which use PG_CONN and a fixed Neo4j URI. Only the maintenance scripts read these, so setting PG_HOST here moves those scripts and not the gateway: a known, unfixed fork.
# PG_HOST=localhost
# PG_PORT=5432
# PG_USER=postgres
# PG_DATABASE=agent_data
#
# verify_schema_init.py's connection database, for its throwaway comparison database.
# PG_MAINTENANCE_DB=postgres
#
# Read by the maintenance scripts that touch the graph.
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
#
# sync_project_registry.py: similarity at which a close name is flagged as a possible duplicate.
# PROJECT_CLOSE_MATCH_CUTOFF=0.6
#
# sync_project_registry.py: os.pathsep-separated roots. Empty: pass --roots.
# PROJECT_ROOTS=
# ⛔ THE ACTUAL DATABASE CONFIGURATION, read by the gateway and apply.py. This repository is public: never write a real DSN here. Placeholder shape:
# PG_CONN=postgresql://USER:PASSWORD@HOST:5432/DBNAME


# Trigram similarity at which a new section is held as a typo. >0 and <=1; any other value stops the gateway.
# DOMAIN_CONFUSABLE_SIMILARITY=0.6

# The same for entity names at save. >0 and <=1; any other value stops the gateway.
# ENTITY_CONFUSABLE_SIMILARITY=0.6

# The same for project names.
# PROJECT_CONFUSABLE_SIMILARITY=0.6

# Shortest entity name the noise filter accepts.
# MIN_ENTITY_NAME_LEN=2

# entity_fragment_rate.py only: longest plausible entity name in words.
# MAX_ENTITY_NAME_WORDS=4

# REM's temperature. Falls back to DREAM_TEMPERATURE, then 0.6.
# REM_TEMPERATURE=0.6

# NREM's temperature, same fallback.
# NREM_TEMPERATURE=0.6

# Leading characters of a judgement body given to the insight slot prompt.
# NREM_INSIGHT_SLOT_INPUT_CHARS=2000

# Seconds REM yields to a write burst when SLOT_AWARE is off.
# WRITE_QUIESCE_SEC=30

# Largest encoder POST body buffered; above it, HTTP 413.
# EMBED_RERANK_BUFFER_CAP=1048576

# Seconds idle before a backend is a wedge suspect.
# LLM_WEDGE_SUSPECT_AGE=900

# Largest secret file read before refusing.
# SECURE_ENV_SECRET_FILE_MAX_BYTES=65536

# Overrides the ontology.yaml location.
# SMEM_ONTOLOGY_PATH=

# ⛔ DEPRECATED: migrate_retro_edges.py derives this from GATEWAY_URL. One-release override, with a warning.
# EMBED_URL=

# pool_status.py only: where it reads status from.
# POOL_STATUS_URL=http://localhost:8888/pool/status

# Longest entity name a save may carry before refusal.
# ENTITY_NAME_MAX_LEN=200

# Most entities one save may name.
# ENTITY_LIST_MAX_LEN=50

# Candidate entity names REM may propose per record.
# ENTITY_PROPOSAL_LIMIT=5

# Graph edges per anchored record in a search result.
# GRAPH_EXPANSION_LIMIT=15

# Graph neighbours one lineage reply names.
# LINEAGE_RELATED_CAP=50

# Row cap on /memory/graph; over it, HTTP 400.
# GRAPH_QUERY_ROW_CAP=10000

# Tier-1 candidates fetched for the reranker. A floor: max(this, the caller's limit).
# SEARCH_CANDIDATE_FLOOR=20

# Most entries in the `domains` filter. Over it the request is REFUSED, never truncated: a partial filter would read as authoritative.
# SEARCH_DOMAINS_FILTER_CAP=16

# Most refs one search-by-ref call may name.
# SEARCH_REFS_CAP=16

# Retry-After for a write shed during backup quiesce.
# BACKUP_RETRY_AFTER=30
