# =============================================================
# Shared Memory Framework — FRAMEWORK Configuration
#
# This is the FRAMEWORK env. It lives in the framework folder and is read by
# the gateway/daemons AND by docker-compose (data paths + DB passwords below):
#     shared-memory/.env         ← live values (gitignored, NEVER commit)
#     shared-memory/.env.example ← this sanitized template (committed)
# The CLIENT token lives separately in the skill folder's .env (AGENT_TOKEN);
# see shared-memory-skill/shared-memory/.env.example.
#
# First-time setup: run  bash shared-memory/scripts/install_framework.sh
# (prompts for the values below, writes shared-memory/.env, creates data dirs).
# Or copy this file to shared-memory/.env and fill in the values by hand.
# =============================================================

# -------------------------------------------------------------
# Infrastructure — host paths for docker-compose (postgres_neo4j_limits.yaml).
# These are substituted into the compose at `docker compose --env-file
# shared-memory/.env ...`. No trailing slash. README §5 (Docker Compose).
# -------------------------------------------------------------
# Neo4j host dir — compose mounts {data,logs,import,plugins} underneath it.
NEO4J_HOST_DIR=/your/data/path/neo4j
# Postgres data dir.
PG_DATA_DIR=/your/data/path/postgres
# GGUF model dir for the bundled BGE-M3 embedder + reranker containers.
# Only needed if you run the compose inference layer (skip if you use LM Studio).
LLM_MODELS_DIR=/path/to/your/LLM_Models

# -------------------------------------------------------------
# Secrets — you must set these. README §5 (Docker Compose) / §6 (Schema).
#
# DEPLOYER FILE-BASED ALTERNATIVES (SEC-06, PR A4, extended fix round 1) —
# every secret-classified key below — AND any other name ending
# _PASSWORD/_TOKEN/_API_KEY/_SECRET/_KEY/_CREDENTIAL(S), e.g. a provider key
# like DEEPSEEK_API_KEY, or AGENT_TOKEN — can be delivered WITHOUT ever
# writing the literal value to this file, in order of precedence (highest
# first; each skipped if unset):
#   1. $CREDENTIALS_DIRECTORY/<key, lowercased>  — systemd LoadCredential=;
#      see the commented example in ops/hive-mind-gateway.service. Root-
#      mediated delivery, the most locked-down of the three. ANY entry the
#      directory contains becomes a candidate — its UPPERCASED filename IS
#      the key, so this is not limited to a fixed list.
#   2. <KEY>_FILE=/path/to/secret                — Docker official-images
#      convention; works with any file-based secret store (pass, a mounted
#      Docker/K8s secret, a vault-agent template). e.g.:
#        PG_PASSWORD_FILE=/run/secrets/pg_password
#      SETTING THE POINTER IS WHAT MAKES THE KEY A CANDIDATE — a _FILE var
#      for any secret-shaped name is picked up on its own, not only for the
#      names already listed on this page.
#   3. the plaintext value below                 — what every prior release
#      did; still the default and still fine for a single-user dev box.
# An operator's own direct shell/systemd export of the KEY ITSELF (not the
# _FILE pointer) still wins over all three — unchanged since PR A1 — but
# logs one advisory line (key name only, never the value) recommending tier
# 1 or 2 instead. Full precedence statement: shared-memory/scripts/
# secure_env.py module docstring. None of these three tiers, nor the
# plaintext value here, is ever written to os.environ or a child process's
# environment — see that same module. A _FILE pointer for a name that is NOT
# secret-classified is ignored with a warning, never silently treated as one.
# -------------------------------------------------------------
NEO4J_PASSWORD=your-neo4j-password-here
PG_PASSWORD=your-postgres-password-here

# Optional — only if you use the LM Studio web-search MCP. README §16.
# Consumed by mcp.json → tavily-mcp; the Python stack does not read it.
TAVILY_API_KEY=your-tavily-api-key-here

# -------------------------------------------------------------
# Authentication — README §10 (Token setup) and SECURITY.md
# -------------------------------------------------------------

# GATEWAY .env: the agent token registry. Empty = auth DISABLED (all
# requests accepted — the backward-compatible default). Generate with:
#   uv run python shared-memory/scripts/generate_tokens.py
# Format: comma-separated entries, one per agent, DIGEST form REQUIRED as of
# v0.9.3 — a plaintext entry makes the gateway REFUSE TO START:
#   name:sha256:<64-hex-digest>   (what generate_tokens.py prints —
#                                  a digest is not a secret, safe to paste)
# Upgrading from an older AGENT_TOKENS line? Convert it once, in place —
# every existing client token keeps working unchanged, only the gateway's
# own storage format changes:
#   uv run python shared-memory/scripts/generate_tokens.py --convert-digests
AGENT_TOKENS=

# GATEWAY .env: S-05 (RULED — decision:1303). AGENT_TOKENS unset + a
# provider-credentialed backend configured (any LLM_BACKENDS_JSON entry
# whose token_env resolved) makes the gateway REFUSE TO START — auth-off
# means the in-flight cap and audit path are off too, and a live provider
# key with none of that guarding it lets any caller that reaches the
# gateway sign a request with it. Two fixes: configure AGENT_TOKENS above,
# or set this to run anyway — a deliberate, explicit acceptance of that
# risk (e.g. a single-operator box with no other network path to :8888).
# An auth-unset install with NO provider-credentialed backend is completely
# unaffected either way.
# ALLOW_UNAUTHENTICATED_PROVIDER_KEYS=1

# GATEWAY .env: optional read-only roles. Confines the named tokens to
# GET /health, GET /memory/telemetry, and POST /memory/graph (read-only
# Cypher) — every other route returns 403. Use for ops clients that must
# observe but never write, e.g. the shared-memory-monitor dashboard.
# Empty / unset = every token keeps full read/write (backward compatible).
# Format: comma-separated name:role pairs; role is "read" or "full".
# AGENT_ROLES=monitor:read

# AGENT skill .env (NOT the gateway): this agent's own token. Each agent
# uses a distinct token — never shared. LM Studio: set it in the mcp.json
# env block instead, then restart LM Studio.
# AGENT_TOKEN=tok_change_me_abc123

# -------------------------------------------------------------
# Logging — all optional; these change what gets recorded. README §14.
# -------------------------------------------------------------

# Per-save log verbosity (memory_bridge.py / vector-skill.py):
#   0 = off (default)        1 = warnings
#   2 = warnings + errors    3 = + successful saves
#   4 = + full content copy (warns if content > 10 KB)
MEMORY_LOG_LEVEL=0

# Directory for per-tool logs (memory_bridge.log, vector_skill.log); the
# consolidation daemon merges them daily into shared_memory_YYYY-MM-DD.log.gz.
MEMORY_LOG_PATH=~/.shared-memory/logs

# REM outbox audit log (JSON-lines, one entry per reviewed outbox row),
# written by rem_loop.py. Empty = disabled (default). Never auto-rotated.
AUDIT_LOG_PATH=

# Gateway per-request audit log (JSON-lines: ts, agent, role, method, path,
# status, latency_ms, request_id; plus principal + connected_from when the client
# connects over the Unix socket), written by the auth middleware OFF the DB hot
# path. The observability tier of agent auditing; pair it with the DB for a full
# picture (README §14 — log = who/from-where, DB = which decision/project).
# Empty = disabled. Not rotated. become non-repudiable once PoP auth lands.
# GATEWAY_AUDIT_LOG_PATH=~/.shared-memory/logs/gateway-audit.jsonl

# Credential-events log (JSON-lines) — ON BY DEFAULT, unlike every other log
# on this page: it is a baseline security control (ISO 27001 A.5.17 property
# 4), not an opt-in diagnostic. Records only HIGH-SIGNAL events: an upstream
# LLM backend rejecting our own provider key (upstream_credential_fault), a
# gateway-side connect/timeout/proxy failure on a credentialed call
# (gateway_fault), a client's bearer token failing to verify
# (token_verify_failed — rate-limited; a no-token request writes no line at
# all, only the credentials.token_verify_failed counter), and every
# daemon-token mint (daemon_token_issued). Never the token/key value itself —
# only an 8-hex-char digest prefix where applicable. Default path shown below;
# set to an EMPTY STRING to disable. Rotation needs the logrotate timer
# installed (ops/shared-memory-logrotate.timer) — same *-audit.jsonl glob as
# GATEWAY_AUDIT_LOG_PATH above, nothing extra to configure once it's running.
# CREDENTIAL_AUDIT_LOG_PATH=~/.shared-memory/logs/credential-audit.jsonl
#
# token_verify_failed LOG LINE rate limit (token bucket) — an unauthenticated
# caller fully controls this event's volume, so the LINE is throttled while
# the counter above stays unthrottled. Defaults: 60 lines burst, refilled
# evenly over 60 seconds.
# TOKEN_VERIFY_FAILED_LOG_RATE=60
# TOKEN_VERIFY_FAILED_LOG_WINDOW=60

# -------------------------------------------------------------
# Optional — only set these if your deployment differs from the defaults
# -------------------------------------------------------------

# Person identity (the operator). The gateway reads the OS login account behind
# each connection from the kernel via SO_PEERCRED and stamps it as `principal`
# (+ a `connected_from` fingerprint) on every write and audit line — never from
# the request, so an agent cannot forge it. Requires connecting over the AF_UNIX
# listener below; over TCP the principal is honestly absent. README §14.
#
# Gateway Unix-socket path. Default $XDG_RUNTIME_DIR/shared-memory-gw.sock (per-user,
# 0700 dir → only that user reaches it — right for a single-user box). For a
# multi-user gateway set a shared path and widen GATEWAY_UDS_MODE. Set ="" to disable.
# GATEWAY_UDS_PATH=
# GATEWAY_UDS_MODE=0600
#
# Reject write routes that arrive without a kernel-attested principal (i.e. force
# clients onto the Unix socket). Off by default so the TCP path keeps working during
# rollout; turn on once every writer is on the socket.
# GATEWAY_REQUIRE_PRINCIPAL=0
#
# Client side: the Unix socket memory_bridge connects over so its saves get a
# principal. Default auto-detects $XDG_RUNTIME_DIR/shared-memory-gw.sock; set ="" to
# force TCP. Must match the gateway's GATEWAY_UDS_PATH.
# COORDINATOR_UDS=

# Network interface the gateway binds to. README §9 / SECURITY.md.
# Default 127.0.0.1 (localhost only). Set 0.0.0.0 ONLY behind an encrypted
# overlay (Tailscale / WireGuard / TLS) — bearer tokens are plaintext over HTTP.
# PROXY_BIND=127.0.0.1

# Where an agent reaches the gateway. README §10a (Remote Clients).
# Default http://localhost:8888 is correct for same-host and SSH-tunnel
# clients; override only if your tunnel maps a different local port.
# COORDINATOR_URL=http://localhost:8888

# Dreaming LLM sampling temperature (REM enrichment + NREM consolidation).
# Per-daemon: REM_TEMPERATURE / NREM_TEMPERATURE; DREAM_TEMPERATURE sets both. Default 0.6.
# Tune per local model: Gemma ~0.6, Mistral-3 Instruct/Qwen ~0.1, Mistral-3 Reasoning ~1.0.
# DREAM_TEMPERATURE=0.6

# Interval between NREM global density sweeps — the safety net that drains
# clusters which crossed the density threshold without a triggering save
# (e.g. NOTIFYs lost while the daemon was down). The first sweep runs on the
# first idle tick after startup. Default 3600.
# NREM_SWEEP_INTERVAL_SEC=3600

# ── Dream-cycle generation bounds and failure handling ───────────────────────
# Every reasoning call sets max_tokens, and a length-finish FAILS the unit: a
# truncated draft is never repair-salvaged, never persisted, never fed to a
# quality gate. Because a fixed bound plus a dead-letter cap would silently and
# permanently exclude any record or cluster that legitimately needs more room,
# the bound is widened ONCE and the call retried before the unit fails. Raise
# the base bound (not the factor) if your model is consistently more verbose.
# REM_MAX_TOKENS_SOLO=1500
# REM_MAX_TOKENS_PER_FACT=400
# REM_MAX_TOKENS_PER_SUMMARY=250
# REM_TRUNCATION_RETRY_FACTOR=2.0
# A truncated REM solo/batch generation is classified degenerate (repetition
# loop) or honest before it retries — a degenerate one retries at the SAME
# bound instead of the widened one. Either way a bounded tail of the
# completion body is kept for diagnosis: this many trailing characters, in
# the journal WARN and the dream-metrics JSONL row, never the full body and
# never the persisted record.
# REM_TRUNCATION_SPECIMEN_CHARS=500
# NREM's two fold prompts are CUMULATIVE — each is handed the previous summary /
# insight and told to expand it — so a fold must re-emit that whole narrative
# before adding one new record. The previous narrative's length is a hard FLOOR
# under these bounds, and it grows every time the fold succeeds. Set below that
# floor the fold cannot succeed at all: obeying the bound drops content and
# fails the preservation gate, obeying the gate overruns the bound and truncates
# — then the dead-letter cap drops the cluster. Busiest domains cross first.
# Raise these if a legitimately larger narrative truncates; truncation_failures
# on GET /memory/telemetry is the signal. The practical ceiling is generation
# TIME (LLM_CEILING_FLOOR), not the model's context window.
# NREM_MAX_TOKENS_SUMMARY=8192
# NREM_MAX_TOKENS_INSIGHT=8192
# NREM_TRUNCATION_RETRY_FACTOR=2.0

# Per-call hard ceiling (seconds) for every dream LLM call, so a valid long
# generation is never killed for being long. The effective ceiling is the
# LARGEST of: this floor, prompt_chars/100, work_units*15, and — since decode
# time is driven by the OUTPUT bound, not the input — max_tokens/LLM_MIN_TOK_S.
# LLM_CEILING_FLOOR=600

# Slowest generation rate (tokens/second) the ceiling will sit through. THIS IS
# HARDWARE, so it is the one value you should expect to change: set it from your
# own throughput, deliberately UNDER your observed floor rather than at your
# average — a ceiling sized on the average kills every slower-than-average run.
# Reference measurement on the development rig (Qwen3-14B Q4_K_M, one Intel Arc
# card, single slot): min 11.29, mean 13.93, max 15.10 tok/s -> shipped as 10.
# Raising a NREM_MAX_TOKENS_* bound without checking this is what turns "needs a
# longer narrative" into an opaque timeout that is never counted as a capacity
# failure. Keep max_tokens/LLM_MIN_TOK_S under NREM_FORCED_SLOT_WAIT (1800s) or
# a long fold outlasts REM's willingness to yield the shared LLM slot.
# LLM_MIN_TOK_S=10

# Dream-cycle LLM telemetry sink (N-2, Model_Attributes_Routing_Plan_2026-08-18
# — dream_telemetry.py). Each REM/NREM LLM call always logs a structured line;
# setting this ADDITIONALLY writes one JSONL object per call (tok/s, prompt/
# predicted token counts, wall vs ceiling time, and — additive — prompt_chars,
# N-4) to this file for offline analysis (e.g. re-measuring LLM_CHARS_PER_
# TOKEN_RATIO above from real traffic once enough history accumulates). Unset
# = no file, structured logging only.
# DREAM_METRICS_PATH=~/.shared-memory/logs/dream-metrics.jsonl

# ── Embedder sizing ──────────────────────────────────────────────────────────
# The embedder's context is the invariant here. BGE-M3 has a hard 8192-token
# window and REFUSES a larger input outright (HTTP 500 "input is too large to
# process") rather than truncating it, so every caller clamps what it sends —
# and because the input is clamped, the longest embedding call the framework can
# make is a fixed, known quantity that the request timeout is computed from.
# Set this to YOUR embedder's context if you run a different one.
# EMBED_MAX_CONTEXT_TOKENS=8192
#
# Conservative characters-per-token, used for BOTH the clamp and the token
# estimate. Held below the ~4.3 measured for English prose because code,
# identifiers and non-English text tokenize denser: a low value truncates
# earlier (never overruns the context) and over-estimates tokens (never
# under-sizes the timeout) — both errors land on the safe side.
# EMBED_CHARS_PER_TOKEN=3.0
#
# Longest input ever sent to the embedder. Defaults to the two values above
# multiplied (8192 * 3.0 = 24576); set it explicitly only to override that.
# The FULL text is always stored in Tier 1 and still returned by search — only
# the vector is computed from the leading slice.
# EMBED_MAX_CHARS=24576
#
# Slowest embedding rate (tokens/second) the timeout will sit through. LIKE
# LLM_MIN_TOK_S, THIS IS HARDWARE — and like it, set it under your observed
# floor, never at your average. Embedding cost is superlinear in input length,
# so throughput FALLS as the input grows and a floor taken from small inputs
# will not cover large ones: measured on the development rig (BGE-M3 335M Q8_0,
# llama.cpp, CPU, four threads) throughput fell from 438 tok/s at 236 tokens to
# 148 tok/s at 7414 -> shipped as 100. A GPU-backed embedder should raise this
# substantially; note the reference rig runs the embedder on CPU.
# EMBED_MIN_TOK_S=100
#
# Margin over the derived time, and the floor for small inputs (connection
# setup, and queueing behind another request — the embedder serialises).
# At the shipped defaults a full-context call gets 8192/100*1.5 = 123s against
# a measured true cost of about 59s at that size.
# EMBED_SAFETY_FACTOR=1.5
# EMBED_TIMEOUT_FLOOR_S=20
#
# ── Reranking ────────────────────────────────────────────────────────────────
# The SAME rule as the embedder above, on the backend it was never applied to.
# The reranker scores each (query, document) pair, so its cost tracks the TOTAL
# text sent, not the document count.
#
# Longest text ever sent PER DOCUMENT. A relevance WINDOW, not a truncation of
# the record: the full text is still stored and still returned by search.
# ⛔ RETRIEVAL SELECTS ON THE EMBEDDING WINDOW, so ranking on a NARROWER slice can
# demote a record for lacking the very text it was selected for. Measured on the
# reference corpus, narrowing to 2000 chars kept only about half of reranking's
# gain over plain vector order. It is nonetheless the dominant latency lever: at a
# fixed thread count, narrowing a 20-candidate set to 2000 chars took it from 64s
# to 30s, and throughput IMPROVES as documents shorten (attention is quadratic).
# Defaults to EMBED_MAX_CHARS so ranking and retrieval see the SAME text. Lower
# it only as a deliberate latency trade — see the warning above.
# RERANK_MAX_DOC_CHARS=24576
#
# Slowest reranking rate (characters/second) the timeout will sit through. LIKE
# EMBED_MIN_TOK_S, THIS IS HARDWARE — set it under your observed floor, never at
# your average. Measured on the development rig (BGE-Reranker-v2-m3 568M Q8_0,
# llama.cpp, CPU, four threads): 1447 char/s on a 20k-char payload falling to
# 887 char/s on a 129k-char one -> shipped as 800. A GPU-backed reranker should
# raise this substantially.
# RERANK_MIN_CHARS_S=800
#
# Margin over the derived time, and the floor for small payloads. At the shipped
# defaults a full 20-candidate set gets 20*2000/800*1.5 = 75s against a measured
# true cost of about 30s for that payload on the reference rig.
# RERANK_SAFETY_FACTOR=1.5
# RERANK_TIMEOUT_FLOOR_S=10
#
# ── Backend capability probing ───────────────────────────────────────────────
# /health reports whether the critical backends can SERVE, not merely whether
# they answer — a reranker that is up and cannot finish a real request inside
# the caller's timeout reads as healthy under a liveness ping, and did. The
# probe costs real inference time on the backends that serve traffic, so it runs
# on a background cadence and /health only ever reads its cached result.
# CAPABILITY_PROBE_INTERVAL_S=600
# CAPABILITY_PROBE_DOCS=4
# CAPABILITY_PROBE_DOC_CHARS=1000
#
# ⚠ THE PROBE HAS A CONSUMER: both clients size their search timeout from it.
# The client knobs (SEARCH_TIMEOUT_S and friends) live in the CLIENT env —
# shared-memory-skill/shared-memory/.env.example — because they are read by
# memory_bridge.py and vector-skill.py, not by the gateway. Setting them here
# has no effect unless a client happens to run with this file loaded.
#
# ── Inference container exposure and CPU budget (docker compose) ──────────────
# Host interface the embedder/reranker ports are published on. Loopback by
# default: NEITHER SERVICE HAS ANY AUTHENTICATION, so publishing them on all
# interfaces puts an open embedding/reranking endpoint on your network. Change
# this only if the gateway runs on a different host, and only over a network
# you trust.
# INFERENCE_BIND=127.0.0.1
#
# CPU threads for each encoder container. install_framework.sh derives this from
# the host as (THREADS / 2 + 1) — counted in threads because that is the unit
# `--threads` takes. Leaves room for Postgres, Neo4j, the gateway and your desktop.
# NOTE it is PER CONTAINER and there are two encoders that can run at once; lower
# it, or pin each to its own cores, if they overlap under sustained load here. NOTE that raising it buys much less than it
# looks like it should: 5x the threads measured 2x the speed, because these
# models saturate memory bandwidth long before they saturate cores.
# LLAMA_CPU_THREADS=4
#
# ── Encoders on a GPU (compose.gpu-encoders.yaml) ────────────────────────────
# Only read when you add the GPU overlay:
#   docker compose -f postgres_neo4j_limits.yaml -f compose.gpu-encoders.yaml \
#                  --env-file shared-memory/.env up -d
# Which card both encoders use. llama.cpp enumerates Vulkan devices in DRIVER
# order, which need not match PCI order — read the device list the container
# prints at startup rather than assuming an index. Both encoders are pinned to
# the same card on purpose, leaving your other GPU free for the reasoning LLM.
# ENCODER_GPU_INDEX=0
#
# Group that owns your render node (`stat -c '%g' /dev/dri/renderD128`). The
# container must be in it to open the device.
# GPU_RENDER_GID=video

# Poison-record escape hatch: a record whose enrichment fails this many times
# is dead-lettered — dropped from REM's queue until an operator resets
# n.rem_attempts. Only failures ATTRIBUTABLE TO THE RECORD count (its line was
# unparseable, its write failed); a transport failure such as a pool 503 says
# nothing about the record and is never charged. Watch rem_dead_lettered on
# GET /memory/telemetry — non-zero means enrichment is losing records.
# REM_MAX_ATTEMPTS=5

# REM naming authority is NOT configurable, and there is deliberately no setting
# here for it. The enrichment pass LINKS but never MINTS: a proposed relationship
# to a name that is not already a node is dropped, never created (the count
# appears in the journal as "REM mint gate"). It may also only link to an Entity
# that first write named — one carrying a MENTIONS edge with no asserted_by from
# a real record — so an entity the enrichment pass introduced to itself can never
# become a target for more of its own links (the withheld count appears in the
# journal as "REM accept set"). Entity creation stays on the capture path, where
# a person named the concept; the observed failure mode was sentence fragments
# becoming Entity nodes and then polluting alias resolution and summary keys.

# REM entity grounding — two DIFFERENT sets, bounded separately.
#
# The names REM will ACCEPT from the LLM (the link gate above resolves against
# this) and the names it SHOWS the LLM in the prompt used to be one capped list.
# Past the cap, a known entity whose name sorted late fell out of BOTH: never
# offered, and rejected if named anyway — so the mention was dropped and that
# entity's cluster silently stopped growing toward the fold threshold.
#
# ENTITY_REGISTRY_LIMIT — the ACCEPT set: a safety valve, not a working limit.
#   The gate needs every typed node or it rejects names that exist. It is only a
#   dict of strings; keep it well above your node count. Hitting it logs a
#   warning and means "prune the graph", not "this is fine".
# ENTITY_PROMPT_K — the SHOW set: the k entities nearest to THIS record's text by
#   cosine over the entity-embedding store. Relevance-ranked instead of
#   alphabetical, so the prompt gets SMALLER as the graph grows, not larger.
#   Raise it if records routinely reference many entities at once.
# ENTITY_SET_LIMIT — the FALLBACK slice size, used when semantic recall is
#   unavailable (embedder unreachable, empty embedding store). Grounding matters
#   most during an outage, so recall degrades to the previous alphabetical
#   behaviour and never to an empty list.
# GROUNDING_EMBED_CAP — chars of a record's text sent to the embedder for ranking.
# ENTITY_REGISTRY_LIMIT=20000
# ENTITY_PROMPT_K=80
# ENTITY_SET_LIMIT=1500
# GROUNDING_EMBED_CAP=4000

# Fold dead-letter: a cluster that fails the preservation or truncation gate
# this many times within the window is skipped rather than re-folded forever.
# NREM_FOLD_FAIL_CAP=3
# NREM_FOLD_FAIL_WINDOW=7

# Preservation-gate corrective retries. The RULE itself (every decision/
# retrospective anchor is hard-required, zero coverage tolerance — the
# operator's core demand: no captured record may silently vanish from a
# synthesised narrative) is NOT controlled by this and does not change. This
# only bounds how many corrective attempts the gate gets before giving up —
# raised from 1 to 2 once measurement showed a decision cluster's anchor set
# is several independent tokens that must ALL match on the SAME attempt, so
# one retry's recovery probability compounds down fast as cluster size grows.
# NREM_PRESERVATION_MAX_RETRIES=2

# Preservation-gate slack floor. Soft (plain-fact) anchors tolerate a little
# paraphrase loss, budgeted as floor(cluster_size * 0.10) dropped anchors. That
# ratio quantises to ZERO for any cluster below ten records — and since the
# density threshold makes five-to-nine the ordinary cluster size, the tolerance
# never reached the common case, while a ten-record cluster got a free drop its
# nine-record neighbour did not. Clusters of at least this many records now get
# at least one droppable soft anchor. Decision/retrospective anchors remain
# hard-required regardless: this floor can never rescue one.
# NREM_PRESERVATION_SLACK_MIN_UNITS=5

# REM/NREM slot arbitration. The two dream daemons share one serial LLM slot.
# REM re-arms faster and its solo units run for minutes, so without an arbiter
# consolidation can defer indefinitely. NREM takes a well-known advisory lock
# while queuing for the slot and REM yields its turn. The wait budget MUST
# exceed your longest REM unit or the queue expires before REM ever finishes.
# Both daemons must agree on the lock key.
# NREM_FORCED_SLOT_WAIT=1800
# NREM_PRIORITY_ADVISORY_LOCK_KEY=8765310

# Idle window before a DUE event-driven consolidation fires (the hard backstop
# is 3x this). Default 900 = the documented 15-minute intent.
# NREM_IDLE_THRESHOLD_SEC=900

# How often NREM re-reads its eligibility predicate: the count of facts sitting
# at 'rem_reviewed' in the outbox, i.e. enriched by REM but not yet folded.
# Due-ness is a property of THAT ledger, never of the save notifications that
# happen to have arrived -- a save means a record was written, not that an
# eligible cluster exists. One cheap indexed read per interval; the interval
# also bounds how stale the observed backlog may be. Default 60.
# NREM_ELIGIBILITY_RECHECK_SEC=60

# How often NREM's idle clock probes the LLM pool. The clock that decides "the
# system is quiet" has to see the whole system: if it only counts saves, REM can
# hold the shared slot for twenty minutes while the clock runs on and NREM
# becomes due mid-batch. Fail-open like every other pool probe. Default 15.
# NREM_POOL_PROBE_SEC=15

# Project-name normalisation (decision 276). Canonical project = folder name.
# The coordinator rewrites metadata.project / decision.project through this
# alias map at ingress so the insight gate's >=2-distinct-projects rule is
# trustworthy. One-time backfill: scripts/normalize_projects.py --map "...".
# Example — adapt to your own folder names:
# PROJECT_ALIASES=shared_mem=my-project,shared_memory=my-project,old-name=my-project

# Insight consolidation mega-hub guard: entities whose total degree exceeds
# this cap never key a decision cluster (context only). Default 50.
# INSIGHT_HUB_DEGREE_CAP=50

# ADR-017 alias-writer (scripts/alias_writer.py) — Tier-2 (LLM-adjudicated)
# cadence (decision 852). Tier 1 (deterministic normalized-exact auto-accept)
# is always unconditional, never gated by this. Tier 2 runs whenever it has
# been at least this many hours since the last one — checked against the
# durable alias_adjudications ledger, not a separate marker, so `--auto` is
# safe to invoke on any schedule. Deliberately does NOT defer to REM/NREM
# pool business: alias-adjudication quality gates consolidation quality (a
# fragmented/wrongly-split entity graph degrades every downstream fold), so
# it is not treated as lower-priority than the dream cycles that depend on it.
# ALIAS_SWEEP_INTERVAL_HOURS=24

# Concurrency for ADR-017 Tier-2 batch dispatch. With LLM_BACKENDS configuring
# more than one backend, dispatching batches concurrently is what lets the
# gateway's least-in-flight routing actually spread them across backends —
# sequential dispatch could never do that. Mirrors LLM_AFFINITY_MAX_INFLIGHT.
# ALIAS_LLM_MAX_CONCURRENT=4

# -------------------------------------------------------------
# Concurrency & load hardening — all optional, sane defaults shown.
# -------------------------------------------------------------

# Postgres pool sizing. This is a SYSTEM budget: pg max_connections must cover
# POOL_MAX + the REM daemon (1) + NREM (per-op) + the LISTEN connection +
# headroom. POOL_ACQUIRE_TIMEOUT bounds how long a request waits for a free
# connection before the gateway sheds it (503 + Retry-After) instead of hanging.
# POOL_MIN=2
# POOL_MAX=20
# POOL_ACQUIRE_TIMEOUT=5.0

# Neo4j driver pool (gateway + both daemons share Neo4j). Bounds queueing under
# concurrent search/daemon contention; acquisition timeout fails fast.
# NEO4J_MAX_POOL=50
# NEO4J_ACQUIRE_TIMEOUT=30.0

# Failed-outbox retry backoff (per row): next_attempt_at = now + base·2^retries
# (capped, jittered). Stops a Neo4j outage becoming a 2 s-cycle retry storm.
# OUTBOX_BACKOFF_BASE=2.0
# OUTBOX_BACKOFF_MAX=300.0

# Per-alternative vectors: a decision's alternatives are stored on the save path
# and embedded afterwards by a background worker. The interval is a LATENCY knob
# only — pending work is a committed row (`embedding IS NULL`), so nothing is
# lost by sweeping less often, and a restart mid-flight loses nothing either.
# ALT_VECTOR_POLL_INTERVAL=10.0
# ALT_VECTOR_BATCH_SIZE=32
# Consecutive failures after which a row is reported as `failing` in telemetry.
# NOT a give-up threshold: no value of it stops a row being retried, because a
# failure here is nearly always the embedder being unavailable rather than
# anything about the row.
# ALT_VECTOR_FAILING_AFTER=5

# Per-entity write-lock registry cap. Idle locks evict LRU past this bound so
# the map can't grow unbounded with unique entity names. Default 4096.
# LOCKS_MAX_SIZE=4096

# Outer load-shed valve: max concurrent in-flight requests at the auth seam
# (counts requests parked on slow embeddings/LLM too). 0 = disabled (default).
# Applies BEFORE every auth exemption (S-11) — an anonymous /health or
# /pool/status hit can be shed too, not just authenticated traffic.
# GATEWAY_INFLIGHT_MAX=0

# TTL (seconds) on the cached result of /health's own upstream fan-out (S-11)
# — embedder, reranker, every LLM backend, the wedge probe when suspect.
# /health is polled frequently (the monitor, `doctor`) and none of that
# traffic needs a fresh probe every single hit; a few seconds absorbs a
# burst while a real outage still shows up fast. Shared by anonymous and
# authenticated callers alike — only the response SHAPE differs per caller,
# computed fresh on every request from the same cached probe.
# HEALTH_CACHE_TTL_S=3

# Consolidation signal (ADR-018) — dream-cycle liveness on /health + telemetry.
# STALL_THRESHOLD defaults to 2.5× NREM_SWEEP_INTERVAL_SEC (the insight cycle
# rides every sweep) so a single deferred/failed sweep never trips the alert.
# ORPHAN_TIMEOUT: an in-flight run row older than this reads as a dead-mid-fold
# crash, not a live fold. RETENTION: the daemon prunes older run rows at startup.
# CONSOLIDATION_STALL_THRESHOLD_SEC=9000
# CONSOLIDATION_HEALTH_REFRESH_SEC=60
# CONSOLIDATION_ORPHAN_TIMEOUT_SEC=1800
# CONSOLIDATION_RUNS_RETENTION_DAYS=30

# ── Backup (ops/backup.sh — gateway host only) ───────────────────────────────
# Policy (schedule/retention/destination) is YOURS; the script ships the mechanism.
# Mint an admin-role token and grant it the 'admin' role so backup.sh can
# quiesce the gateway over POST /admin/backup. An admin token is confined
# to /admin/* — it cannot read or write memory. Unlike the per-agent tokens
# generate_tokens.py mints itself, this one is a value YOU choose (below);
# get its digest entry with --digest (reads the token from stdin, never
# argv, prints nothing else):
#   printf '%s' tok_backup_xxx | uv run python shared-memory/scripts/generate_tokens.py --digest backup
#   AGENT_TOKENS=...,backup:sha256:<digest-of-tok_backup_xxx>
#   AGENT_ROLES=monitor:read,backup:admin
# BACKUP_ADMIN_TOKEN is the RAW token backup.sh presents as its Bearer
# credential — it must be the plaintext value the digest above was hashed
# from (the registry itself never stores it in recoverable form).
# BACKUP_ADMIN_TOKEN=tok_backup_xxx
# BACKUP_DIR=~/.shared-memory/backups
# BACKUP_RETENTION_DAYS=14
# BACKUP_QUIESCE_MAX_SECONDS=900     # gateway TTL auto-resume if the script dies
# BACKUP_DRAIN_MAX_SECONDS=120       # wait for the outbox to drain before dumping
# BACKUP_QUIESCE_REQUIRED=0          # 1 = abort if the gateway can't be quiesced
# Advisory-lock key shared by gateway + REM + NREM (change all three together):
# BACKUP_ADVISORY_LOCK_KEY=8765309
# Container / DB names (compose defaults shown):
# PG_CONTAINER=postgres-vector
# NEO4J_CONTAINER=neo4j-memory

# Reasoning-LLM backend POOL (OPTIONAL). The gateway owns LLM routing + load
# parallelisation: clients only ever call the gateway (/v1/chat/completions) and
# never know how many models back it or where they run. List one OR MORE
# OpenAI-compatible backends — local or REMOTE host. Unset = a single backend at
# LLM_DEFAULT_TARGET (below). Selection is least-in-flight, so concurrent work
# (REM + NREM, or the future LLM-judge) fans out across free backends; a down
# backend is skipped for a short cooldown so one card always keeps serving.
# LLM_BACKENDS=http://localhost:5000,http://localhost:4000,http://remote-host:1234
#   each entry is a backend url (an optional url@weight is still honoured, but the
#   default equal weight is preferred). ⚠ HONESTY NOTE (M-4, Model_Attributes_
#   Routing_Plan_2026-08-18): "weight" currently affects NO live routing decision
#   — dispatch is cache-affinity then least-in-flight (below), never weighted; the
#   value is stored and shown on /health for display only. Making it meaningful
#   again is a possible future change, not something to rely on today. Dispatch
#   is CACHE-AFFINITY first — a request
#   whose large prompt PREFIX is already warm on a backend (llama.cpp KV prefix-cache)
#   is routed back there (huge win for a big shared grounding prefix), then
#   least-in-flight while protecting warm cards from eviction. Allocation-free; no
#   precomputed capacity split. Judge/quality reservation is decided by the GATEWAY at
#   runtime (e.g. the periodical recheck reserves a card then releases it) — never env.
#
# LLM_BACKENDS_JSON — takes priority over LLM_BACKENDS above when set. Use this
# form instead when any backend needs its own credential (a paid cloud API),
# its own model id, or its own request-body switches; the plain comma form has
# no way to carry any of them.
# LLM_BACKENDS_JSON=[{"url":"http://localhost:5000"},
#                     {"url":"https://api.deepseek.com/v1",
#                      "token_env":"DEEPSEEK_API_KEY","model":"deepseek-chat",
#                      "extra_body":{"thinking":{"type":"disabled"}}}]
#   ── Installing a provider API key, start to finish ─────────────────────
#   (everything you need is in this file — no searching elsewhere mid-setup)
#   1. Put the raw key in its OWN file, nothing else in it, unreadable to
#      other users:
#        install -m 600 /dev/null ~/.secrets/deepseek_api_key
#      then paste the key into that file with your editor — never into this
#      .env, and never via `echo` (shell history keeps it).
#   2. Point the gateway at the file — ONE line in this .env:
#        DEEPSEEK_API_KEY_FILE=/home/<you>/.secrets/deepseek_api_key
#      The `<NAME>_FILE` pointer is what makes the key a candidate (full
#      resolution order — LoadCredential= beats _FILE beats a plain env var —
#      in the credential block at the top of this file; hardened systemd
#      installs prefer LoadCredential=).
#   3. Add the backend entry to LLM_BACKENDS_JSON with
#      "token_env":"DEEPSEEK_API_KEY" — the var NAME from step 2, never the
#      key — plus your routing choice: "private_ok": true (may serve
#      everything) or "roles": [...] (per-function opt-in). A credentialed
#      entry with NEITHER refuses gateway startup, on purpose.
#   4. Restart the gateway. Verify on the authenticated /health: the backend
#      reads "ok" in llm_backends (a bare-probe 401/403 from a credentialed
#      backend counts as alive) and its roster entry shows
#      has_credential: true.
#   ───────────────────────────────────────────────────────────────────────
#   "token_env" NAMES an env var the gateway process must already have —
#   NEVER a literal key here or anywhere else this framework writes to disk.
#   Resolved once at startup and sent as Authorization ONLY to that backend;
#   a client's own gateway auth token is never forwarded to any backend. A
#   named var that isn't actually set in the environment excludes that backend
#   from the pool (logged) rather than sending a doomed request. "model"
#   overrides LLM_MODEL below for that backend only. "extra_body" is an object
#   merged into every chat payload routed to that backend (overriding the
#   caller's fields) — the place for provider-specific switches such as
#   disabling a hybrid model's thinking mode; a non-object value excludes the
#   backend from the pool (logged). Full credential-handling
#   guidance (keep the raw key in an encrypted store, never in a file) is in
#   shared-memory/ops/README.md, "Reasoning-LLM backends" section.
#
#   Model-attributes routing (Model_Attributes_Routing_Plan_2026-08-18) —
#   four MORE optional per-entry fields, all additive:
#
#   "roles": ["extract","verify","judge"]  — which dream FUNCTIONS this
#     backend may serve. Absent (the default) = serves all, the homogeneous-
#     fleet case every existing install keeps unchanged. "summarize" is
#     RESERVED (NREM narrative folds are zero-inference by construction —
#     the only NREM LLM path is insight folds, which IS "judge") and is
#     refused at startup if named. An explicit roles list is itself the
#     per-function PRIVACY OPT-IN (see private_ok below) — a private_ok:false
#     backend that lists a role in roles IS eligible for that role's
#     traffic, privacy notwithstanding. Role-LESS traffic (an ad-hoc
#     authenticated chat, no dream role header) ignores a backend's roles
#     list entirely and is gated purely on private_ok — a local card pinned
#     to "extract" must not refuse an ad-hoc chat.
#   "n_ctx": 32768  — the model's usable context in tokens. Absent = no fit
#     information (this backend is assumed to always fit). When set, a
#     request whose estimated size would not fit is excluded from this
#     backend rather than sent and truncated/rejected upstream. See
#     LLM_CHARS_PER_TOKEN_RATIO / FIT_MARGIN below for how the estimate and
#     its safety margin are derived.
#   "private_ok": true|false  — may this backend see role-less/private
#     traffic and serve as a "roles absent" degenerate default? DEFAULT =
#     (no token_env present): an uncredentialed/local backend defaults
#     true, a provider-credentialed one defaults false (a paid API is
#     opt-IN to private/role-less traffic, never opt-out-by-omission). An
#     EXPLICIT value here always wins over the default either way.
#     ⛔ A credentialed backend with NEITHER roles NOR an explicit
#     private_ok REFUSES GATEWAY STARTUP (loud, named message) — pick one:
#     private_ok:true (today's serve-everything) or roles:[...] (scope it to
#     specific functions). This is a one-time config decision per
#     credentialed backend on upgrade, not a recurring choice.
#     ⛔ ALSO: an install with NO gateway auth configured (AGENT_TOKENS
#     unset) and ANY private_ok:false backend refuses to start too — without
#     caller identities the privacy/steering guarantees a scoped backend
#     exists for cannot be enforced. Governed by the SAME override as S-05's
#     "auth off + a live provider key" refusal:
#     ALLOW_UNAUTHENTICATED_PROVIDER_KEYS=1 (see above in this file).
#   "max_inflight": 2  — per-backend concurrency ceiling. Absent = unbounded
#     (today's behavior). A backend at its cap is treated as busy in
#     selection (the request goes to the next eligible backend); if the
#     capped backend is the ONLY eligible one, the request WAITS on it
#     (bounded by LLM_MAX_INFLIGHT_WAIT_S below) rather than overriding the
#     cap or falling back to an ineligible backend.
#   "price_per_mtok_in": 0.14, "price_per_mtok_out": 0.28  — OPTIONAL,
#     operator-maintained USD-per-million-token prices, stored and surfaced
#     on the authenticated /health payload for a MONITOR to multiply against
#     the token counters below. The gateway itself never reads these for any
#     routing decision — it stays price-agnostic by design.
#
#   Empty eligible set (no backend passes role+privacy+fit for a given
#   request) → HTTP 422 {"error":"no_eligible_backend","constraint":
#   "role"|"privacy"|"fit","role":...} — loud, never a silent fallback to an
#   ineligible backend and never a silent widening of what "eligible" means.
#
# LLM_FAIL_THRESHOLD=2   # backend fails within LLM_FAIL_WINDOW → cooldown
# LLM_FAIL_WINDOW=60
# LLM_COOLDOWN=300       # seconds a failing backend is ejected before re-probe
# LLM_AFFINITY_PREFIX_CHARS=6144   # prompt-prefix length hashed for the affinity key
# LLM_AFFINITY_TTL=600             # seconds a warm-prefix→backend mapping is trusted
# LLM_AFFINITY_MAX_INFLIGHT=4      # prefer the warm card unless its queue exceeds this
#
# max_inflight capacity-wait tuning (only matters if any backend declares
# max_inflight above):
# LLM_MAX_INFLIGHT_WAIT_S=120   # give up and 503 after this long waiting on a capped sole-eligible backend
# LLM_MAX_INFLIGHT_POLL_S=0.5   # how often to re-check capacity while waiting (floor 0.05 — 0 would busy-spin)
# ⚠ UNMEASURED (fact:1338 discipline — a shape-chosen bound, not a measured
# one): how many requests may WAIT on capacity at once. Each waiter holds an
# admitted request for up to the full wait window, so unbounded waiters would
# let one saturated capped backend absorb the gateway's whole admission
# budget; beyond this many, requests get an immediate 503 instead of waiting.
# LLM_MAX_CAPACITY_WAITERS=8
#
# Extra agent names allowed to send X-SM-LLM-* steering headers (e.g. an
# operator-run relation sweep that routes as "judge" but runs outside the
# gateway process, so it can never hold a gateway-minted daemon token). Mint
# an ordinary agent token under a name listed here and point the tool at it.
# A NAME allowlist, deliberately: each entry is one identity you chose to
# trust with steering — never a whole role class.
# LLM_STEER_EXTRA_AGENT_NAMES=relation_sweep
#
# Fit-check sizing (only matters for a backend that declares n_ctx above).
# MEASURED (v0.9.13, at build time): 20 live /tokenize comparisons
# against both configured local backends (llama-server, same model on each)
# across prose/JSON/code/SQL/Greek-text samples gave chars/token ranging
# 1.205 (Greek, densest) to 6.905 (English prose, sparsest); a further live
# chat-completion check confirmed the 1.2 floor already overestimates real
# chat-template prompt tokens by 83%-525% in every sample tried. RE-MEASURE
# for your own model/tokenizer if it differs materially from Qwen3-family —
# a denser tokenizer (more tokens per char) needs a lower ratio here.
# LLM_CHARS_PER_TOKEN_RATIO=1.2   # est_prompt_tokens = body_chars / this — the MOST CONSERVATIVE measured ratio, not an average
# ⚠ UNMEASURED (fact:1338 — flagged, not derived from a further live
# measurement): residual headroom below n_ctx, mainly for content denser
# than anything sampled above (heavy CJK/emoji, deeply repeated JSON) plus
# general context bookkeeping (special/BOS-EOS tokens, KV overhead) the
# char-based estimator does not model. Raise if a legitimate request is
# being fit-rejected in practice; the ratio's own conservatism is what does
# most of the real protective work, not this margin.
# FIT_MARGIN=0.10   # fraction of n_ctx held back: eligible iff est_prompt_tokens + effective_max_tokens <= n_ctx * (1 - FIT_MARGIN)
# ⚠ UNMEASURED (fact:1338) — conservative round number, not derived from a
# live measurement; only used when the caller's body has no max_tokens at
# all (the daemons' own task-owned budgets, REM_MAX_TOKENS_*, are the
# actually-measured ceiling for real dream traffic).
# FIT_DEFAULT_OUTPUT_TOKENS=2048   # reserved output budget when the caller sent no max_tokens
#
# Per-backend token-usage accounting (post-review addition A — always on,
# no knob to disable): the gateway parses `usage` off non-streaming LLM
# responses it proxies and keeps IN-PROCESS cumulative prompt/completion
# counters per backend, surfaced on the authenticated /health payload
# (llm_token_usage) with a paired last-event timestamp. ⚠ RESET ON EVERY
# GATEWAY RESTART — a dashboard computing a delta across a restart will read
# a negative number if it doesn't account for this; the paired timestamp is
# what makes a restart-aware delta computable. Bounds how much of a single
# response body is buffered in memory just to look for a trailing `usage`
# object (skipped entirely past this, and for any compressed response):
# LLM_USAGE_CAPTURE_CAP_BYTES=2097152   # 2 MiB
# ⚠ UNMEASURED (fact:1338) convenience knob — 0 (default) disables periodic
# emission; the gateway ALWAYS emits one lifecycle sum line per backend
# (journal + GATEWAY_AUDIT_LOG_PATH above, if set) on graceful shutdown
# regardless of this setting. A nonzero value additionally emits on this
# interval, for bounded loss on a hard kill (no graceful shutdown at all).
# TOKEN_LIFECYCLE_SUM_INTERVAL_S=0

# Single-backend fallback, used ONLY when LLM_BACKENDS is unset. Ports differ by
# stack — LM Studio defaults to :1234, llama.cpp servers commonly :8080 — so set
# this to whatever YOUR reasoning endpoint is rather than inheriting a default.
# LLM_DEFAULT_TARGET=http://localhost:5000

# Model id sent on every reasoning call. "local-model" suits llama.cpp / LM Studio,
# which ignore the field. Set the REAL id for any backend that validates it: vLLM or
# TGI with named models, an OpenRouter/LiteLLM router, an OpenAI-compatible cloud
# endpoint, or LM Studio with several models loaded.
# LLM_MODEL=local-model

# Embedding + reranking endpoints the GATEWAY forwards to. These move the ENDPOINT
# (other ports, another container network, a remote host) — clients never call them
# directly, they always go through the gateway.
#
# NOTE — the embedding/reranking MODELS are part of the fixed contract for now, not a
# flexible surface. The 1024-dim BGE-M3 vector is baked into the schema (vector(1024)
# in 000_base_schema.sql and 014_alias_resolution.sql), there is no dimension guard,
# and once data exists a different-dimension model requires a full RE-EMBED, not a
# config change. Only the reasoning LLM above is freely swappable today.
# EMBEDDER_URL=http://localhost:8070
# RERANKER_URL=http://localhost:8071

# Reference resolution (Stage 1.2b) — materialises textual record cross-references
# ("refines decision 381") as INFORMED_BY / REFERENCES edges. The link is always
# deterministic; only the relationship-TYPE judgment is configurable. The judge is
# the weaker model, so it is gated to the ambiguous Decision->Decision case only and
# its output is strictly validated, with a deterministic fallback.
# REFERENCE_JUDGE_MODE=deterministic       # deterministic (default) | llm
# REFERENCE_JUDGE_URL=http://localhost:5000/v1   # OpenAI-compatible base; e.g. http://atlas:1234/v1 to offload to a separate node
# REFERENCE_JUDGE_MODEL=local-model

# Machine-relation confidence — the enrichment pass proposes an entity link, then
# re-checks it with independent confirm/deny calls. The vote share, shifted by the
# source record's kind, becomes the edge's confidence.
#
# RELCONF_WRITE_FLOOR gates the WRITE: below it the edge is not created at all,
# rather than created and excluded from folding later. Gating consumption alone
# does not contain anything — a low-confidence edge is still what a reader sees on
# the record, and a judgement copies its evidence's links upward. The floor applies
# to ENTITY links only; record→record (evidential) proposals are deliberately born
# below their own consumption threshold so that adjudication, not the proposer,
# promotes them, and a floor would make them unwritable at birth.
#
# 0.68 means: a record citing a real source (code, a test, an external document)
# may link on a two-of-three majority, while an uncited or conversational record
# needs unanimity. Raise it to demand more agreement; lower it to accept more.
# RELCONF_WRITE_FLOOR=0.68
# RELCONF_CONSUME_ENTITY=0.68        # keep in step with the write floor
# RELCONF_CONSUME_EVIDENTIAL=0.70
# RELCONF_MIN_LABELS=20              # operator labels before a family counts as calibrated
