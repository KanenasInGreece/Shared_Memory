# =============================================================
# Shared Memory Framework — Required Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================

# --- Database passwords ---
# Used by: consolidation_loop.py, memory_bridge.py, vector-skill.py,
#          postgres_neo4j_limits.yaml (docker-compose), mcp.json
NEO4J_PASSWORD=your-neo4j-password-here
PG_PASSWORD=your-postgres-password-here

# Derived connection strings (used directly by Python scripts if set)
# Leave blank to let scripts build them from the individual vars above.
# PG_CONN=postgresql://postgres:your-postgres-password-here@localhost:5432/agent_data

# --- API keys ---
# Tavily web-search MCP (used by mcp.json → tavily-mcp server)
TAVILY_API_KEY=your-tavily-api-key-here

# --- Proxy security ---
# PROXY_BIND controls which network interface the Hive-Mind Gateway listens on.
# Default: 127.0.0.1 (localhost only — recommended; API is unauthenticated).
# Set to 0.0.0.0 ONLY if the proxy runs inside an isolated Docker/VM network.
# PROXY_BIND=127.0.0.1

# Agent token registry for request authentication (Phase 2C).
# Format: comma-separated name:token pairs. Each agent includes its token in
# the Authorization: Bearer <token> header. Tokens should be random 32+ char strings.
# Example:
# AGENT_TOKENS=claude:tok_change_me_abc123,gemini:tok_change_me_def456

# --- Ports (change only if you have conflicts) ---
PROXY_PORT=8888
EMBEDDER_PORT=8070
RERANKER_PORT=8071
NEO4J_BOLT_PORT=7687
PG_PORT=5432

# --- LM Studio / local inference ---
# OPENAI_BASE_URL is already set in mcp.json; override here if your proxy runs elsewhere.
# OPENAI_BASE_URL=http://localhost:8888/v1

# --- Audit logging ---
# MEMORY_LOG_LEVEL controls what save_artifact writes to the per-tool log files.
#   0 (default) = no logging
#   1 = warnings (e.g. save succeeded but entities missing — fact ineligible for consolidation)
#   2 = warnings + errors (gateway down, malformed metadata, Neo4j sync failures)
#   3 = warnings + errors + successful saves (pg_id, source, entity count)
#   4 = everything above + full content copy (warns if content > 10 KB)
# MEMORY_LOG_LEVEL=1

# Directory where per-tool logs are written (memory_bridge.log, vector_skill.log).
# The consolidation daemon merges these daily into shared_memory_YYYY-MM-DD.log.gz.
# MEMORY_LOG_PATH=~/.shared-memory/logs
