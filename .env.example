# =============================================================
# Shared Memory Framework — Configuration
#
# Copy this file to .env and fill in the secrets at the top.
# Every parameter the code actually reads is listed below, set to its
# default value, with a pointer to the README chapter that explains it.
# NEVER commit your filled-in .env (it is gitignored).
#
# Two roles share this template:
#   • Gateway .env (repo root) — needs the secrets + AGENT_TOKENS.
#   • Agent skill .env         — needs only AGENT_TOKEN (+ COORDINATOR_URL
#                                for remote / SSH-tunnel clients).
# =============================================================

# -------------------------------------------------------------
# Secrets — no safe default; you must fill these in
# -------------------------------------------------------------

# Database passwords. README §5 (Docker Compose) / §6 (Database Schema).
# Read by coordinator.py, consolidation_loop.py, rem_loop.py, vector-skill.py;
# also consumed by postgres_neo4j_limits.yaml (compose) and mcp.json.
NEO4J_PASSWORD=your-neo4j-password-here
PG_PASSWORD=your-postgres-password-here

# Tavily web-search MCP API key. README §16 (LM Studio MCP — Web search).
# Consumed by mcp.json → tavily-mcp; not read by the Python stack.
TAVILY_API_KEY=your-tavily-api-key-here

# -------------------------------------------------------------
# Authentication — README §10 (Token setup) and SECURITY.md
# -------------------------------------------------------------

# Gateway side: the agent token registry. Empty = auth DISABLED — every
# request is accepted (backward-compatible default). Generate with:
#   uv run python shared-memory/scripts/generate_tokens.py
# Format: comma-separated name:token pairs, one entry per agent.
AGENT_TOKENS=

# Agent side: this agent's own token. Set it in each agent's skill .env,
# NOT in the gateway .env. No shared default — each agent uses a distinct
# token. LM Studio: set in the mcp.json env block, then restart LM Studio.
# AGENT_TOKEN=tok_change_me_abc123

# -------------------------------------------------------------
# Coordinator client — README §10a (Remote Clients) / §11
# -------------------------------------------------------------

# Where memory_bridge.py and vector-skill.py reach the gateway. The
# localhost default is correct for same-host and SSH-tunnel clients (the
# tunnel maps the remote port to local 8888).
COORDINATOR_URL=http://localhost:8888

# Requested agent_id on save/search. With auth enabled the server OVERWRITES
# the stored source with the token-verified agent name, so this is only a
# fallback label. README §12 (The Save Path). Default differs per entry
# point: memory_bridge.py → "memory_bridge", vector-skill.py → "lm_studio".
# AGENT_ID=memory_bridge

# -------------------------------------------------------------
# Gateway network — README §9 (Starting the Full Stack) / SECURITY.md
# -------------------------------------------------------------

# Interface the Hive-Mind Gateway binds to. 127.0.0.1 = localhost only
# (recommended). Set 0.0.0.0 ONLY behind an encrypted overlay network
# (Tailscale / WireGuard / TLS) — bearer tokens travel in plaintext over HTTP.
PROXY_BIND=127.0.0.1

# -------------------------------------------------------------
# Sleep cycle — README §13 (The Sleep Cycle — REM and NREM Consolidation)
# -------------------------------------------------------------

# The REM daemon skips an enrichment cycle if any fact was saved within this
# many seconds — it yields to active write bursts so it never resets NREM's
# idle timer. Read by rem_loop.py.
WRITE_QUIESCE_SEC=30

# -------------------------------------------------------------
# Logging — README §14 (Audit Logging)
# -------------------------------------------------------------

# Per-save log verbosity (memory_bridge.py / vector-skill.py):
#   0 = off (default)         1 = warnings
#   2 = warnings + errors     3 = + successful saves
#   4 = + full content copy (warns if content > 10 KB)
MEMORY_LOG_LEVEL=0

# Directory for per-tool logs (memory_bridge.log, vector_skill.log). The
# consolidation daemon merges them daily into shared_memory_YYYY-MM-DD.log.gz.
MEMORY_LOG_PATH=~/.shared-memory/logs

# REM outbox audit log (JSON-lines, one entry per reviewed outbox row),
# written by rem_loop.py. Empty = disabled (default). Never auto-rotated —
# rotate it externally if it must stay bounded.
AUDIT_LOG_PATH=

# -------------------------------------------------------------
# Testing — README §17 (Testing)
# -------------------------------------------------------------

# Set to 1 to bypass live LLM calls in consolidation / REM tests
# (consolidation_loop.py, rem_loop.py). Leave unset in normal operation.
# MOCK_LLM=1

# -------------------------------------------------------------
# Optional override
# -------------------------------------------------------------

# Full Postgres DSN. Leave unset to let the scripts build it from PG_PASSWORD:
#   postgresql://postgres:${PG_PASSWORD}@localhost:5432/agent_data
# README §5 / §6.
# PG_CONN=postgresql://postgres:your-postgres-password-here@localhost:5432/agent_data

# -------------------------------------------------------------
# Service endpoints — HARDCODED in the scripts, NOT read from env.
# Listed for reference only; changing one requires editing the source.
#   Neo4j Bolt     bolt://localhost:7687   NEO4J_URI in coordinator/consolidation/rem/vector-skill   README §5
#   BGE-M3         http://localhost:8070   EMBED_URL in coordinator.py                                README §7
#   BGE-Reranker   http://localhost:8071   RERANK_URL in coordinator.py                               README §7
#   Reasoning LLM  http://localhost:5000   gateway default route                                      README §7
#   Gateway port   8888                    passed as argv to hive_mind_proxy.py (not an env var)      README §9
# -------------------------------------------------------------
