# =============================================================
# Shared Memory — CLIENT (skill) Configuration
#
# This is the CLIENT env. It lives in the skill folder, beside memory_bridge.py,
# and is read only by the thin client — NOT the gateway/daemons:
#     <skill-dir>/.env          ← live values (gitignored, NEVER commit)
#     <skill-dir>/.env.example  ← this sanitized template (committed)
# At install, <skill-dir> is each agent's own skill path, e.g.
#   ~/.claude/skills/shared-memory/.env   ~/.grok/skills/shared-memory/.env
#   ~/.codex/skills/shared-memory/.env    ~/.gemini/skills/shared-memory/.env
# Each agent uses a DISTINCT token — never shared. LM Studio sets its token in
# mcp.json instead of here. Framework/infra config lives separately in the
# framework env (shared-memory/.env.example). README §10 / §10a.
# =============================================================

# This agent's bearer token. Mint on the gateway host with
#   uv run python shared-memory/scripts/generate_tokens.py
# For a LOCAL install, that command writes this line for you (mode 600) —
# nothing to paste. For a REMOTE agent, the operator reveals it themselves
# (--reveal <name>, ON THE SAME MINT INVOCATION — a later, separate run
# mints a fresh token for every agent, a full rotation — never through an
# agent) and pastes it here. Empty = gateway auth disabled. S-01: this file
# must stay mode 600 (it holds a live bearer token) — generate_tokens.py
# and update_skill.sh both enforce it; if you ever edit this by hand,
# `chmod 600` it afterward.
AGENT_TOKEN=tok_change_me_abc123

# Where this client reaches the gateway. Default http://localhost:8888 is right
# for same-host and SSH-tunnel clients; override only if your tunnel maps a
# different local port. README §10a (Remote Clients).
# COORDINATOR_URL=http://localhost:8888
# Framework HTTP clients ignore HTTP_PROXY / HTTPS_PROXY / ALL_PROXY / NO_PROXY and SSL_CERT_FILE / SSL_CERT_DIR
# (trust_env=False). A client that must cross a proxy reaches the gateway by a tunnel, the UDS socket or an allowlist.

# Unix socket the client connects over so its saves carry an OS-login principal.
# Default auto-detects $XDG_RUNTIME_DIR/shared-memory-gw.sock; set ="" to force
# TCP. Must match the gateway's GATEWAY_UDS_PATH. README §14.
# COORDINATOR_UDS=

# ── How long the client waits for a search ───────────────────────────────────
# A search costs what the RERANKER costs, and that tracks the total candidate
# payload — not the `limit` you asked for, which barely moves it. So the client
# does NOT ship a constant: it reads `backend_capability` from GET /health once
# per process and sizes its own ceiling from the gateway's published projection.
# Nothing here normally needs setting — the point is that the number follows the
# server's hardware, window and model without the client being re-tuned.
#
# Pin a constant instead, in seconds. Overrides the derivation and both clamps —
# the escape hatch, not the normal path. Unset/0 = derive.
# SEARCH_TIMEOUT_S=0
#
# Used when the gateway publishes no usable capability block (older gateway,
# probe not yet run, /health unreachable). Deliberately generous: the failure
# this replaced was a ceiling BELOW the real cost, so an unknown cost must not
# fall back to a small number.
# SEARCH_TIMEOUT_FALLBACK_S=120
#
# Clamps on the derived value. The floor keeps a fast backend from setting a
# ceiling lower than what shipped; the maximum bounds how long an agent will
# ever block on one search.
# SEARCH_TIMEOUT_FLOOR_S=30
# SEARCH_TIMEOUT_MAX_S=300
#
# Margin over the gateway's projection, and a flat allowance for the work that
# sits OUTSIDE both encoder probes — Postgres vector search, the graph traversal
# and response assembly — which is added rather than scaled, because it does not
# grow with encoder throughput.
# SEARCH_SAFETY_FACTOR=1.5
# SEARCH_OVERHEAD_S=15
#
# How long the one-off /health capability read may take. It is a convenience,
# never a dependency: if it times out the client uses the fallback above.
# HEALTH_PROBE_TIMEOUT_S=3

# Per-save client log verbosity (memory_bridge.py):
#   0 = off (default)        1 = warnings
#   2 = warnings + errors    3 = + successful saves
#   4 = + full content copy (warns if content > 10 KB)
# MEMORY_LOG_LEVEL=0

# Directory for the client's per-tool log (memory_bridge.log).
# MEMORY_LOG_PATH=~/.shared-memory/logs

# Project tag stamped on every save from this client. Unset/empty = derived
# by walking UP from the caller's own working directory for the nearest
# PROJECT_ROOT_MARKERS file (below), README §19. Set this for callers whose
# working directory is not a meaningful project boundary — a daemon, CI, a
# cron job — where the walk would land somewhere wrong or nowhere at all.
# SHARED_MEMORY_PROJECT=

# Marker files that identify a project root during that walk, tried in this
# priority order (`.git` first — a repository root is the least ambiguous
# boundary; the agent-instruction files are the fallback for a project
# directory that is not a repository). Comma-separated. Code default shown.
# PROJECT_ROOT_MARKERS=.git,CLAUDE.md,AGENTS.md,GEMINI.md

# ⛔ SECURE_ENV_FILE and AGENT_ID are deliberately NOT templated here (W7 D4).
# SECURE_ENV_FILE is read BEFORE this file is even selected — it SELECTS
# which .env candidate loads, so a value written into the file it selects is
# inert; set it in the shell or an MCP host's own env block instead.
# AGENT_ID is trimmed on purpose: with gateway auth enabled the server
# overwrites this client's agent_id from the token (coordinator.py's
# authenticated_agent wins over any client-sent value), so setting it here
# would teach an operator to configure a name the server ignores. It IS
# real, operator-facing config for the MCP client's own env instead
# (mcp/system-prompt.md) — this exclusion is about THIS file, not a claim
# that AGENT_ID is unconfigurable anywhere.
