# =============================================================
# Shared Memory — CLIENT (skill) Configuration
#
# This is the CLIENT env. It lives in the skill folder, beside memory_bridge.py,
# and is read only by the thin client — NOT the gateway/daemons:
#     <skill-dir>/.env          ← live values (gitignored, NEVER commit)
#     <skill-dir>/.env.example  ← this sanitized template (committed)
# At install, <skill-dir> is each agent's own skill path, e.g.
#   ~/.claude/skills/shared-memory/.env   ~/.grok/skills/shared-memory/.env
#   ~/.codex/skills/shared-memory/.env    ~/.gemini/skills/shared-memory/.env
# Each agent uses a DISTINCT token — never shared. LM Studio sets its token in
# mcp.json instead of here. Framework/infra config lives separately in the
# framework env (shared-memory/.env.example). README §10 / §10a.
# =============================================================

# This agent's bearer token. Mint on the gateway host with
#   uv run python shared-memory/scripts/generate_tokens.py
# then paste the value for THIS agent here. Empty = gateway auth disabled.
AGENT_TOKEN=tok_change_me_abc123

# Where this client reaches the gateway. Default http://localhost:8888 is right
# for same-host and SSH-tunnel clients; override only if your tunnel maps a
# different local port. README §10a (Remote Clients).
# COORDINATOR_URL=http://localhost:8888

# Unix socket the client connects over so its saves carry an OS-login principal.
# Default auto-detects $XDG_RUNTIME_DIR/shared-memory-gw.sock; set ="" to force
# TCP. Must match the gateway's GATEWAY_UDS_PATH. README §14.
# COORDINATOR_UDS=

# Per-save client log verbosity (memory_bridge.py):
#   0 = off (default)        1 = warnings
#   2 = warnings + errors    3 = + successful saves
#   4 = + full content copy (warns if content > 10 KB)
# MEMORY_LOG_LEVEL=0

# Directory for the client's per-tool log (memory_bridge.log).
# MEMORY_LOG_PATH=~/.shared-memory/logs
